{
  "name": "zapdesk",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma de atendimento por WhatsApp com foco em grupos",
  "scripts": {
    "dev": "pnpm --parallel --filter @zapdesk/api --filter @zapdesk/web dev",
    "dev:api": "pnpm --filter @zapdesk/api dev",
    "dev:web": "pnpm --filter @zapdesk/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @zapdesk/database generate",
    "db:migrate": "pnpm --filter @zapdesk/database migrate:dev",
    "db:deploy": "pnpm --filter @zapdesk/database migrate:deploy",
    "db:seed": "pnpm --filter @zapdesk/database seed"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@whiskeysockets/baileys",
      "esbuild",
      "prisma",
      "protobufjs",
      "sharp",
      "bufferutil",
      "utf-8-validate"
    ]
  },
  "packageManager": "pnpm@10.33.0"
}
