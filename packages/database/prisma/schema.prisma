generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Organização (preparação multi-tenant / SaaS)
// ============================================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  departments         Department[]
  whatsappInstances   WhatsAppInstance[]
  conversations       Conversation[]
  contacts            Contact[]
  groups              WhatsAppGroup[]
  messages            Message[]
  tags                Tag[]
  internalNotes       InternalNote[]
  assignmentHistories ConversationAssignmentHistory[]
  auditLogs           AuditLog[]
  quickReplies        QuickReply[]
  scheduledMessages   ScheduledMessage[]
  attendanceSettings  AttendanceSettings?

  @@map("organizations")
}

// ============================================================
// Usuários / Atendentes
// ============================================================

enum UserRole {
  admin
  supervisor
  agent
}

enum UserStatus {
  active
  inactive
}

/// Som do aviso de mensagem recebida. `none` é silêncio escolhido pela
/// pessoa — nunca o estado inicial, que é `sound_1`.
enum NotificationSound {
  none
  sound_1
  sound_2
  sound_3
}

/// Volume do aviso de mensagem recebida, em três degraus perceptivelmente
/// distintos (o ganho de cada um é decidido no frontend, que toca o som).
enum NotificationVolume {
  low
  medium
  high
}

model User {
  id                 String             @id @default(uuid())
  organizationId     String
  name               String
  email              String             @unique
  passwordHash       String
  role               UserRole           @default(agent)
  status             UserStatus         @default(active)
  avatarUrl          String?
  /// Prefixa as mensagens enviadas com o nome do atendente ("Fulano:")
  signMessages       Boolean            @default(false)
  /// Som tocado quando chega mensagem recebida — preferência de cada pessoa
  notificationSound  NotificationSound  @default(sound_1)
  /// Volume do som de notificação
  notificationVolume NotificationVolume @default(medium)
  /// Último login bem-sucedido — null enquanto o usuário nunca entrou
  lastLoginAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization          Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[]                  @relation("AssignedConversations")
  archivedConversations Conversation[]                  @relation("ArchivedConversations")
  sentMessages          Message[]
  internalNotes         InternalNote[]
  performedAssignments  ConversationAssignmentHistory[] @relation("PerformedAssignments")
  auditLogs             AuditLog[]
  quickReplies          QuickReply[]
  scheduledMessages     ScheduledMessage[]
  whatsappAccess        UserWhatsAppInstance[]
  departmentAccess      UserDepartment[]
  defaultForDepartments Department[]                    @relation("DepartmentDefaultAssignee")
  defaultForInstances   WhatsAppInstance[]              @relation("InstanceDefaultAssignee")

  @@index([organizationId])
  @@map("users")
}

// ============================================================
// Departamentos
// ============================================================

model Department {
  id                String   @id @default(uuid())
  organizationId    String
  name              String
  description       String?
  color             String?
  /// Responsável padrão: assume as conversas que entram neste departamento
  /// sem ninguém atribuído. Precisa ter acesso ao próprio departamento.
  defaultAssigneeId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultAssignee User?                  @relation("DepartmentDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  conversations   Conversation[]
  userAccess      UserDepartment[]
  instances       WhatsAppInstance[]
  tagLinks        TagDepartment[]
  quickReplyLinks QuickReplyDepartment[]

  @@unique([organizationId, name])
  @@map("departments")
}

// ============================================================
// Instâncias de WhatsApp (multi-número)
// ============================================================

enum InstanceStatus {
  disconnected
  connecting
  qr_required
  connected
  reconnecting
  error
}

model WhatsAppInstance {
  id                  String         @id @default(uuid())
  organizationId      String
  name                String
  phoneNumber         String?
  /// Departamento em que as conversas deste número entram por padrão.
  departmentId        String?
  /// Responsável padrão do número: assume as conversas que chegam sem
  /// ninguém atribuído e que o departamento não resolveu. É o caso do
  /// número dedicado a uma pessoa, que não passa por departamento.
  defaultAssigneeId   String?
  /// Número de backup: existe só para o caso de o principal ser banido.
  /// Ligado, toda conversa nova deste número já nasce arquivada — sem isso o
  /// chip reserva duplicaria a Inbox e todos os números do dashboard.
  isBackup            Boolean        @default(false)
  status              InstanceStatus @default(disconnected)
  provider            String         @default("qrcode")
  sessionId           String         @unique @default(uuid())
  lastConnectionAt    DateTime?
  lastDisconnectionAt DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department      Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  defaultAssignee User?                  @relation("InstanceDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  conversations   Conversation[]
  groups          WhatsAppGroup[]
  contacts        Contact[]
  userAccess      UserWhatsAppInstance[]

  @@index([organizationId])
  @@index([departmentId])
  @@index([defaultAssigneeId])
  @@map("whatsapp_instances")
}

/// Quais números de WhatsApp cada usuário enxerga.
/// Sem nenhuma linha = sem acesso a conversa nenhuma (admin é a exceção).
model UserWhatsAppInstance {
  userId             String
  whatsappInstanceId String
  createdAt          DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  instance WhatsAppInstance @relation(fields: [whatsappInstanceId], references: [id], onDelete: Cascade)

  @@id([userId, whatsappInstanceId])
  @@index([whatsappInstanceId])
  @@map("user_whatsapp_instances")
}

/// Em quais departamentos cada usuário atua.
/// Sem nenhuma linha = sem acesso a conversa nenhuma (admin é a exceção).
model UserDepartment {
  userId       String
  departmentId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@index([departmentId])
  @@map("user_departments")
}

// ============================================================
// Contatos
// ============================================================

model Contact {
  id                 String   @id @default(uuid())
  organizationId     String
  whatsappInstanceId String
  externalId         String
  phoneNumber        String?
  name               String?
  pushName           String?
  avatarUrl          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instance     WhatsAppInstance @relation(fields: [whatsappInstanceId], references: [id], onDelete: Cascade)

  @@unique([whatsappInstanceId, externalId])
  @@index([organizationId, phoneNumber])
  @@map("contacts")
}

// ============================================================
// Grupos (entidade de primeira classe)
// ============================================================

model WhatsAppGroup {
  id                 String    @id @default(uuid())
  organizationId     String
  whatsappInstanceId String
  externalId         String
  name               String
  description        String?
  imageUrl           String?
  participantCount   Int       @default(0)
  conversationId     String?   @unique
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instance     WhatsAppInstance   @relation(fields: [whatsappInstanceId], references: [id], onDelete: Cascade)
  conversation Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  participants GroupParticipant[]

  @@unique([whatsappInstanceId, externalId])
  @@map("whatsapp_groups")
}

/// Papel da pessoa dentro do cliente, marcado pela equipe.
///
/// Não confundir com `isAdmin`: aquele é administrador do GRUPO no WhatsApp e
/// vem do sync; este é atributo de cadastro e só muda por ação de gente.
enum ParticipantClientRole {
  partner
  administrative
}

model GroupParticipant {
  id                String                 @id @default(uuid())
  groupId           String
  externalContactId String
  phoneNumber       String
  /// Nome que vem do WhatsApp (perfil ou agenda do celular conectado).
  name              String?
  /// Nome definido pela equipe — ganha do `name` na exibição.
  customName        String?
  /// Sócio ou contato administrativo do cliente; null = sem marcação.
  /// Não confundir com `isAdmin`, que é administrador do grupo no WhatsApp
  /// e vem do sync. Desde que o texto livre "sócio" saiu da conversa, esta
  /// é a única marcação de quem representa o cliente do lado do WhatsApp.
  clientRole        ParticipantClientRole?
  isAdmin           Boolean                @default(false)
  isSuperAdmin      Boolean                @default(false)
  /// Chave do arquivo da foto no storage (null = sem foto conhecida)
  avatarUrl         String?
  /// Última tentativa de buscar a foto — evita reconsultar o WhatsApp toda hora
  avatarCheckedAt   DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  group WhatsAppGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, externalContactId])
  @@map("group_participants")
}

// ============================================================
// Conversas
// ============================================================

enum ConversationType {
  individual
  group
}

enum ConversationStatus {
  open
  waiting_client
  waiting_internal
  resolved
}

model Conversation {
  id                 String             @id @default(uuid())
  organizationId     String
  whatsappInstanceId String
  externalChatId     String
  type               ConversationType
  /// Nome que vem do WhatsApp (nome do grupo ou do perfil). O sync sobrescreve.
  title              String
  /// Nome definido pela equipe. Tem prioridade sobre `title` na exibição e
  /// nunca é tocado pela sincronização.
  customTitle        String?
  profilePicture     String?
  status             ConversationStatus @default(open)
  assignedUserId     String?
  /// Atribuição coletiva ("@todos"): o atendimento é de todo o departamento,
  /// por decisão, e não de uma pessoa. Convive com `assignedUserId` NULO de
  /// propósito — a visibilidade já sai da regra existente (o atendente vê o
  /// que é dele mais o que está sem responsável), então nada em access.ts
  /// muda e não há usuário fictício "@todos" no banco. A coluna serve para
  /// distinguir o coletivo da conversa órfã esperando alguém pegar: as duas
  /// aparecem igual na Inbox, mas só a órfã deve entrar nas contagens de
  /// "sem responsável" e receber responsável padrão.
  /// Constraint no banco garante que marcação e responsável nunca coexistem.
  assignedToAll      Boolean            @default(false)
  departmentId       String?
  unreadCount        Int                @default(0)
  /// Arquivamento: a data responde "está arquivada?" (nulo = não). É
  /// ORTOGONAL ao status — não existe quinto status, e ao desarquivar a
  /// conversa volta com o status que tinha. Mensagem nova NÃO desarquiva.
  archivedAt         DateTime?
  /// Quem arquivou; nulo no arquivamento automático do número de backup.
  archivedByUserId   String?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  // Integrações futuras (CRM, processos, contratos...) — sem dependência específica
  externalReference  String?
  externalSource     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization      Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instance          WhatsAppInstance                @relation(fields: [whatsappInstanceId], references: [id], onDelete: Cascade)
  assignedUser      User?                           @relation("AssignedConversations", fields: [assignedUserId], references: [id], onDelete: SetNull)
  archivedBy        User?                           @relation("ArchivedConversations", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  department        Department?                     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  messages          Message[]
  group             WhatsAppGroup?
  internalNotes     InternalNote[]
  tags              ConversationTag[]
  assignmentHistory ConversationAssignmentHistory[]
  scheduledMessages ScheduledMessage[]

  @@unique([whatsappInstanceId, externalChatId])
  @@index([organizationId, status])
  @@index([organizationId, lastMessageAt])
  /// Dashboard: conversas com atividade no período agrupadas por status, e as
  /// candidatas a atraso (não resolvidas, paradas há mais que o limite).
  @@index([organizationId, status, lastMessageAt])
  /// Inbox: não arquivadas de um recorte ordenadas por última mensagem —
  /// o archivedAt vem antes para o filtro "IS NULL" usar o mesmo índice.
  @@index([organizationId, archivedAt, lastMessageAt])
  @@map("conversations")
}

// ============================================================
// Mensagens
// ============================================================

enum MessageDirection {
  inbound
  outbound
}

enum MessageType {
  text
  image
  audio
  video
  document
  sticker
  location
  contact
  poll
  call
  other
}

enum MessageStatus {
  pending
  sent
  delivered
  read
  failed
}

model Message {
  id                String           @id @default(uuid())
  organizationId    String
  conversationId    String
  externalMessageId String?
  senderExternalId  String?
  senderName        String?
  senderPhone       String?
  direction         MessageDirection
  type              MessageType
  content           String?
  mediaUrl          String?
  mimeType          String?
  filename          String?
  quotedMessageId   String?
  timestamp         DateTime
  status            MessageStatus    @default(pending)
  sentByUserId      String?
  /// Apagada para todos (mantemos a linha para histórico/auditoria)
  deletedAt         DateTime?
  deletedByUserId   String?
  /// Última edição do texto, quando houve
  editedAt          DateTime?
  /// Dados extras por tipo (ex.: opções da enquete)
  metadata          Json?
  createdAt         DateTime         @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sentByUser   User?             @relation(fields: [sentByUserId], references: [id], onDelete: SetNull)
  reactions    MessageReaction[]

  @@unique([conversationId, externalMessageId])
  @@index([conversationId, timestamp])
  @@index([organizationId, timestamp])
  @@map("messages")
}

// ============================================================
// Reações às mensagens (emoji)
// ============================================================

model MessageReaction {
  id               String   @id @default(uuid())
  messageId        String
  emoji            String
  /// JID de quem reagiu (ou o número conectado, quando fromMe)
  senderExternalId String
  senderName       String?
  fromMe           Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, senderExternalId])
  @@index([messageId])
  @@map("message_reactions")
}

// ============================================================
// Notas internas (não vão para o WhatsApp)
// ============================================================

model InternalNote {
  id             String   @id @default(uuid())
  organizationId String
  conversationId String
  userId         String?
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@map("internal_notes")
}

// ============================================================
// Etiquetas
// ============================================================

model Tag {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  color          String   @default("#6366f1")
  /// Vale para a organização inteira. Com ela ligada não existe vínculo em
  /// `departments`; desligada, a etiqueta precisa de pelo menos um.
  ///
  /// "Geral" é esta flag, e não a lista vazia: se lista vazia significasse
  /// geral, excluir um departamento tornaria uma etiqueta restrita visível
  /// para todo mundo sem ninguém perceber.
  isGeneral      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments   TagDepartment[]
  conversations ConversationTag[]

  // Nome único na organização inteira: a etiqueta aparece na conversa sem
  // dizer de qual departamento é, então dois "URGENTE" seriam indistinguíveis.
  @@unique([organizationId, name])
  @@index([isGeneral])
  @@map("tags")
}

/// Uma etiqueta serve a vários departamentos ao mesmo tempo: o mesmo
/// "Urgente" vale para Contábil, Fiscal e DP sem precisar de três cadastros.
model TagDepartment {
  tagId        String
  departmentId String

  tag        Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  // Cascade nas duas pontas. Excluir o departamento apaga só este vínculo —
  // a etiqueta continua existindo, some para quem não é admin e fica na tela
  // de gestão para o admin arrumar.
  @@id([tagId, departmentId])
  @@index([departmentId])
  @@map("tag_departments")
}

model ConversationTag {
  conversationId String
  tagId          String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@map("conversation_tags")
}

// ============================================================
// Histórico de atribuição de atendimento
// ============================================================

enum AssignmentAction {
  assigned
  transferred_user
  transferred_department
  unassigned
  /// Entrou no atendimento coletivo ("@todos"). Ação própria porque
  /// `assigned` significa pessoa: reaproveitá-la faria o histórico dizer
  /// "assumiu o atendimento" para uma marcação que não tem dono.
  assigned_to_all
  /// Saiu do coletivo — seja por ficar sem responsável, seja por alguém
  /// assumir (aí vem seguida de `assigned`).
  unassigned_from_all
  resolved
  reopened
}

model ConversationAssignmentHistory {
  id                String           @id @default(uuid())
  organizationId    String
  conversationId    String
  action            AssignmentAction
  fromUserId        String?
  toUserId          String?
  fromDepartmentId  String?
  toDepartmentId    String?
  performedByUserId String?
  note              String?
  createdAt         DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  performedBy  User?        @relation("PerformedAssignments", fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map("conversation_assignment_history")
}

// ============================================================
// Respostas rápidas (atalho com "/" no composer)
// ============================================================

model QuickReply {
  id             String   @id @default(uuid())
  organizationId String
  /// Atalho digitado após a barra, ex.: "bomdia" -> /bomdia
  shortcut       String
  title          String?
  content        String
  /// Vale para a organização inteira. Mesma regra da etiqueta: com ela
  /// ligada não existe vínculo em `departments`; desligada, precisa de pelo
  /// menos um.
  isGeneral      Boolean  @default(false)
  /// Mídia opcional (imagem, áudio ou vídeo) que sai junto com o texto.
  /// `mediaUrl` é a chave no MediaStorage — mesmo esquema da Message; a
  /// imagem nunca sai por URL pública, só por rota autenticada.
  mediaUrl       String?
  mediaMimeType  String?
  mediaFilename  String?
  /// Última vez que o atalho foi de fato ENVIADO pelo composer (não a
  /// edição do cadastro). É como a equipe descobre resposta parada que
  /// ninguém usa mais. Null = nunca usada desde que a coluna existe.
  lastUsedAt     DateTime?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments  QuickReplyDepartment[]
  createdBy    User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  // Atalho único na organização: "/bomdia" não pode significar duas coisas
  // diferentes dependendo de quem digita.
  @@unique([organizationId, shortcut])
  @@index([isGeneral])
  @@map("quick_replies")
}

/// O mesmo texto padrão serve a vários departamentos — ver TagDepartment.
model QuickReplyDepartment {
  quickReplyId String
  departmentId String

  quickReply QuickReply @relation(fields: [quickReplyId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([quickReplyId, departmentId])
  @@index([departmentId])
  @@map("quick_reply_departments")
}

// ============================================================
// Mensagens agendadas
// ============================================================

enum ScheduledMessageStatus {
  pending
  sent
  failed
  canceled
}

model ScheduledMessage {
  id             String                 @id @default(uuid())
  organizationId String
  conversationId String
  content        String
  scheduledFor   DateTime
  status         ScheduledMessageStatus @default(pending)
  createdById    String?
  sentMessageId  String?
  error          String?
  /// Tentativas de envio já realizadas (falhas temporárias são retentadas)
  attempts       Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@index([conversationId])
  @@map("scheduled_messages")
}

// ============================================================
// Auditoria
// ============================================================

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ============================================================
// Parâmetros de atendimento (SLA e expediente)
// ============================================================

/// Política de atendimento do escritório: em quanto tempo o cliente precisa
/// ser respondido e em que horários esse tempo corre. Fica no banco, e não
/// no código, porque muda sem deploy — e o dashboard lê a cada requisição.
///
/// Uma linha por organização hoje. A tabela filha aponta para esta, e não
/// para a organização: no dia em que existir parâmetro por departamento,
/// basta uma nova linha aqui. Nenhuma coluna de departamento agora.
model AttendanceSettings {
  id                   String   @id @default(uuid())
  organizationId       String   @unique
  /// Minutos sem resposta, contados só dentro do expediente, para o
  /// atendimento entrar como atrasado.
  responseLimitMinutes Int      @default(30)
  /// Fuso do escritório. Todo corte de data do dashboard usa este fuso,
  /// nunca o UTC do servidor.
  timezone             String   @default("America/Sao_Paulo")
  /// Liga a restrição de horário de login. Desligada por padrão: ligada de
  /// saída, um deploy trancaria do lado de fora quem já estava trabalhando.
  loginRestrictionEnabled Boolean @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessHours AttendanceBusinessHours[]
  loginHours    AttendanceLoginHours[]

  @@map("attendance_settings")
}

/// Expediente de um dia da semana. Sete linhas por configuração — cada dia
/// se liga e desliga sozinho, porque o escritório pode passar a atender
/// sábado de manhã sem mexer nos outros dias.
model AttendanceBusinessHours {
  id         String  @id @default(uuid())
  settingsId String
  /// 0 = domingo ... 6 = sábado, igual a `Date#getDay()` e a `EXTRACT(DOW)`.
  weekday    Int
  active     Boolean @default(true)
  /// "HH:MM" no fuso da configuração. Texto, e não `time`, porque é
  /// exatamente o formato que a tela envia e que o cálculo consome.
  startTime  String  @default("08:00")
  endTime    String  @default("18:00")

  settings AttendanceSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, weekday])
  @@map("attendance_business_hours")
}

/// Janela de login de um dia da semana, aplicada só a quem não é supervisor.
/// Tabela separada do expediente porque as duas faixas não são a mesma coisa:
/// o expediente mede o atraso do dashboard, esta aqui diz quem consegue
/// entrar. Sete linhas por configuração, cada dia ligando sozinho.
model AttendanceLoginHours {
  id         String  @id @default(uuid())
  settingsId String
  /// 0 = domingo ... 6 = sábado, igual a `Date#getDay()` e a `EXTRACT(DOW)`.
  weekday    Int
  /// Dia desligado é dia sem login nenhum para quem não é supervisor.
  active     Boolean @default(true)
  /// "HH:MM" no fuso da configuração, mesmo formato do expediente.
  startTime  String  @default("07:00")
  endTime    String  @default("19:00")

  settings AttendanceSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, weekday])
  @@map("attendance_login_hours")
}
