generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Organização (preparação multi-tenant / SaaS)
// ============================================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  departments         Department[]
  whatsappInstances   WhatsAppInstance[]
  conversations       Conversation[]
  contacts            Contact[]
  groups              WhatsAppGroup[]
  messages            Message[]
  tags                Tag[]
  internalNotes       InternalNote[]
  assignmentHistories ConversationAssignmentHistory[]
  auditLogs           AuditLog[]
  quickReplies        QuickReply[]
  scheduledMessages   ScheduledMessage[]
  conversationReads   ConversationRead[]
  attendanceSettings  AttendanceSettings?
  rolePermissions     RolePermission[]
  personProfiles      PersonProfile[]
  pinnedItems         PinnedItem[]
  integrationTokens   IntegrationToken[]
  crmPipelines        CrmPipeline[]
  crmStages           CrmStage[]
  crmOpportunities    CrmOpportunity[]
  crmActivities       CrmActivity[]
  crmOpportunityEvents CrmOpportunityEvent[]
  crmProducts         CrmProduct[]
  crmLossReasons      CrmLossReason[]

  @@map("organizations")
}

// ============================================================
// Usuários / Atendentes
// ============================================================

enum UserRole {
  admin
  supervisor
  agent
}

enum UserStatus {
  active
  inactive
}

/// Som do aviso de mensagem recebida. `none` é silêncio escolhido pela
/// pessoa — nunca o estado inicial, que é `sound_1`.
enum NotificationSound {
  none
  sound_1
  sound_2
  sound_3
}

/// Volume do aviso de mensagem recebida, em três degraus perceptivelmente
/// distintos (o ganho de cada um é decidido no frontend, que toca o som).
enum NotificationVolume {
  low
  medium
  high
}

model User {
  id                 String             @id @default(uuid())
  organizationId     String
  name               String
  email              String             @unique
  passwordHash       String
  role               UserRole           @default(agent)
  status             UserStatus         @default(active)
  avatarUrl          String?
  /// Prefixa as mensagens enviadas com o nome do atendente ("Fulano:")
  signMessages       Boolean            @default(false)
  /// Som tocado quando chega mensagem recebida — preferência de cada pessoa
  notificationSound  NotificationSound  @default(sound_1)
  /// Volume do som de notificação
  notificationVolume NotificationVolume @default(medium)
  /// Último login bem-sucedido — null enquanto o usuário nunca entrou
  lastLoginAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization          Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[]                  @relation("AssignedConversations")
  archivedConversations Conversation[]                  @relation("ArchivedConversations")
  sentMessages          Message[]
  internalNotes         InternalNote[]
  performedAssignments  ConversationAssignmentHistory[] @relation("PerformedAssignments")
  auditLogs             AuditLog[]
  quickReplies          QuickReply[]
  scheduledMessages     ScheduledMessage[]
  whatsappAccess        UserWhatsAppInstance[]
  departmentAccess      UserDepartment[]
  defaultForDepartments Department[]                    @relation("DepartmentDefaultAssignee")
  defaultForInstances   WhatsAppInstance[]              @relation("InstanceDefaultAssignee")
  permissionChanges     RolePermission[]                @relation("RolePermissionUpdatedBy")
  conversationReads     ConversationRead[]
  pinnedItems           PinnedItem[]
  integrationTokens     IntegrationToken[]              @relation("IntegrationTokenCreatedBy")
  crmPipelinesCreated   CrmPipeline[]                   @relation("CrmPipelineCreatedBy")
  crmStageActions       CrmStageAction[]                @relation("CrmStageActionUser")
  crmAssignedOpportunities CrmOpportunity[]             @relation("CrmAssignedOpportunities")
  crmCreatedOpportunities  CrmOpportunity[]             @relation("CrmCreatedOpportunities")
  crmAssignedActivities CrmActivity[]                   @relation("CrmAssignedActivities")
  crmCompletedActivities CrmActivity[]                  @relation("CrmCompletedActivities")
  crmPerformedEvents    CrmOpportunityEvent[]           @relation("CrmPerformedEvents")

  @@index([organizationId])
  @@map("users")
}

// ============================================================
// Departamentos
// ============================================================

model Department {
  id                String   @id @default(uuid())
  organizationId    String
  name              String
  description       String?
  color             String?
  /// Responsável padrão: assume as conversas que entram neste departamento
  /// sem ninguém atribuído. Precisa ter acesso ao próprio departamento.
  defaultAssigneeId String?
  /// Departamento INTERNO: as conversas dele não entram em número nenhum
  /// (dashboard, atrasados agora e relatório por atendente). Existe porque
  /// grupo interno da equipe não é atendimento a cliente, e contá-lo como
  /// tal inflava o painel — principalmente o "Atrasados agora", já que a
  /// última mensagem de um grupo interno é quase sempre "do cliente" aos
  /// olhos do sistema e ninguém "responde" a ela.
  /// **Não é arquivamento**: a conversa continua na lista, continua contando
  /// não lidas, tocando o som e piscando o título. O que muda é só a
  /// contagem — visibilidade não é tocada em lugar nenhum.
  isInternal        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultAssignee User?                  @relation("DepartmentDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  conversations   Conversation[]
  userAccess      UserDepartment[]
  instances       WhatsAppInstance[]
  tagLinks        TagDepartment[]
  quickReplyLinks QuickReplyDepartment[]
  crmPipelineLinks CrmPipelineDepartment[]
  crmOpportunities CrmOpportunity[]
  crmStageActions  CrmStageAction[]      @relation("CrmStageActionDepartment")

  @@unique([organizationId, name])
  @@map("departments")
}

// ============================================================
// Instâncias de WhatsApp (multi-número)
// ============================================================

enum InstanceStatus {
  disconnected
  connecting
  qr_required
  connected
  reconnecting
  error
}

model WhatsAppInstance {
  id                  String         @id @default(uuid())
  organizationId      String
  name                String
  phoneNumber         String?
  /// Departamento em que as conversas deste número entram por padrão.
  departmentId        String?
  /// Responsável padrão do número: assume as conversas que chegam sem
  /// ninguém atribuído e que o departamento não resolveu. É o caso do
  /// número dedicado a uma pessoa, que não passa por departamento.
  defaultAssigneeId   String?
  /// Número de backup: existe só para o caso de o principal ser banido.
  /// Ligado, toda conversa nova deste número já nasce arquivada — sem isso o
  /// chip reserva duplicaria a Inbox e todos os números do dashboard.
  isBackup            Boolean        @default(false)
  status              InstanceStatus @default(disconnected)
  provider            String         @default("qrcode")
  sessionId           String         @unique @default(uuid())
  lastConnectionAt    DateTime?
  lastDisconnectionAt DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department      Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  defaultAssignee User?                  @relation("InstanceDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  conversations     Conversation[]
  groups            WhatsAppGroup[]
  contacts          Contact[]
  userAccess        UserWhatsAppInstance[]
  integrationTokens IntegrationToken[]

  @@index([organizationId])
  @@index([departmentId])
  @@index([defaultAssigneeId])
  @@map("whatsapp_instances")
}

/// Quais números de WhatsApp cada usuário enxerga.
/// Sem nenhuma linha = sem acesso a conversa nenhuma (admin é a exceção).
model UserWhatsAppInstance {
  userId             String
  whatsappInstanceId String
  createdAt          DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  instance WhatsAppInstance @relation(fields: [whatsappInstanceId], references: [id], onDelete: Cascade)

  @@id([userId, whatsappInstanceId])
  @@index([whatsappInstanceId])
  @@map("user_whatsapp_instances")
}

/// Em quais departamentos cada usuário atua.
/// Sem nenhuma linha = sem acesso a conversa nenhuma (admin é a exceção).
model UserDepartment {
  userId       String
  departmentId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@index([departmentId])
  @@map("user_departments")
}

// ============================================================
// Contatos
// ============================================================

model Contact {
  id                 String   @id @default(uuid())
  organizationId     String
  whatsappInstanceId String
  externalId         String
  phoneNumber        String?
  name               String?
  pushName           String?
  avatarUrl          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instance     WhatsAppInstance @relation(fields: [whatsappInstanceId], references: [id], onDelete: Cascade)

  @@unique([whatsappInstanceId, externalId])
  @@index([organizationId, phoneNumber])
  @@map("contacts")
}

// ============================================================
// Grupos (entidade de primeira classe)
// ============================================================

model WhatsAppGroup {
  id                 String    @id @default(uuid())
  organizationId     String
  whatsappInstanceId String
  externalId         String
  name               String
  description        String?
  imageUrl           String?
  participantCount   Int       @default(0)
  conversationId     String?   @unique
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instance     WhatsAppInstance   @relation(fields: [whatsappInstanceId], references: [id], onDelete: Cascade)
  conversation Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  participants GroupParticipant[]

  @@unique([whatsappInstanceId, externalId])
  @@map("whatsapp_groups")
}

/// Papel da pessoa dentro do cliente, marcado pela equipe.
///
/// Não confundir com `isAdmin`: aquele é administrador do GRUPO no WhatsApp e
/// vem do sync; este é atributo de cadastro e só muda por ação de gente.
enum ParticipantClientRole {
  partner
  administrative
}

model GroupParticipant {
  id                String                 @id @default(uuid())
  groupId           String
  externalContactId String
  phoneNumber       String
  /// Nome que vem do WhatsApp (perfil ou agenda do celular conectado).
  name              String?
  /// Nome definido pela equipe — ganha do `name` na exibição.
  customName        String?
  /// Sócio ou contato administrativo do cliente; null = sem marcação.
  /// Não confundir com `isAdmin`, que é administrador do grupo no WhatsApp
  /// e vem do sync. Desde que o texto livre "sócio" saiu da conversa, esta
  /// é a única marcação de quem representa o cliente do lado do WhatsApp.
  clientRole        ParticipantClientRole?
  isAdmin           Boolean                @default(false)
  isSuperAdmin      Boolean                @default(false)
  /// Chave do arquivo da foto no storage (null = sem foto conhecida)
  avatarUrl         String?
  /// Última tentativa de buscar a foto — evita reconsultar o WhatsApp toda hora
  avatarCheckedAt   DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  group WhatsAppGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, externalContactId])
  @@map("group_participants")
}

/// O que a equipe sabe sobre UMA PESSOA do WhatsApp, único na organização.
///
/// A identidade saiu da linha do grupo (`GroupParticipant`) para cá porque a
/// mesma pessoa participa de vários grupos do mesmo cliente (Geral, Contábil,
/// Fiscal, DP): editar grupo a grupo obrigava a repetir a correção, e na
/// prática ninguém repetia — o dado ficava certo num lugar e errado nos
/// outros. `GroupParticipant` continua com o que é do GRUPO (participação,
/// isAdmin, foto); o que é da PESSOA (nome dado pela equipe, papel no
/// cliente) mora aqui.
///
/// Não é o `Contact`: aquele é por número conectado (`@@unique(instanceId,
/// externalId)`), vem do sync da agenda e só existe para quem está nela. O
/// registro da pessoa precisa ser único na ORGANIZAÇÃO e existir para
/// qualquer participante — inclusive `@lid` fora de qualquer agenda.
///
/// LINHA EXISTENTE = a equipe já decidiu no nível da pessoa, e os valores
/// dela valem MESMO QUANDO NULOS (limpar o nome é decisão, não ausência).
/// Linha ausente = vale o legado por grupo, que ficou nas colunas antigas.
model PersonProfile {
  id             String                 @id @default(uuid())
  organizationId String
  /// Identificador da pessoa no WhatsApp (JID normalizado) — o mesmo valor
  /// de `GroupParticipant.externalContactId`. Pode ser `@s.whatsapp.net` ou
  /// `@lid`; o LID é estável, então ele também unifica entre grupos.
  externalId     String
  /// Telefone conhecido (dígitos), copiado da participação. Serve de ponte
  /// para a conversa individual quando ela usa outro endereçamento do mesmo
  /// número. NUNCA é chave de fusão de registros — só de exibição.
  phoneNumber    String?
  /// Nome definido pela equipe — vale em todos os grupos e telas.
  customName     String?
  /// Papel da pessoa dentro do cliente (sócio/administrativo), da equipe.
  clientRole     ParticipantClientRole?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, externalId])
  @@index([organizationId, phoneNumber])
  @@map("person_profiles")
}

// ============================================================
// Conversas
// ============================================================

enum ConversationType {
  individual
  group
}

enum ConversationStatus {
  open
  waiting_client
  waiting_internal
  resolved
}

model Conversation {
  id                 String             @id @default(uuid())
  organizationId     String
  whatsappInstanceId String
  externalChatId     String
  type               ConversationType
  /// Nome que vem do WhatsApp (nome do grupo ou do perfil). O sync sobrescreve.
  title              String
  /// Nome definido pela equipe. Tem prioridade sobre `title` na exibição e
  /// nunca é tocado pela sincronização.
  customTitle        String?
  profilePicture     String?
  status             ConversationStatus @default(open)
  assignedUserId     String?
  /// Atribuição coletiva ("@todos"): o atendimento é de todo o departamento,
  /// por decisão, e não de uma pessoa. Convive com `assignedUserId` NULO de
  /// propósito — a visibilidade já sai da regra existente (o atendente vê o
  /// que é dele mais o que está sem responsável), então nada em access.ts
  /// muda e não há usuário fictício "@todos" no banco. A coluna serve para
  /// distinguir o coletivo da conversa órfã esperando alguém pegar: as duas
  /// aparecem igual na Inbox, mas só a órfã deve entrar nas contagens de
  /// "sem responsável" e receber responsável padrão.
  /// Constraint no banco garante que marcação e responsável nunca coexistem.
  assignedToAll      Boolean            @default(false)
  departmentId       String?
  /// APOSENTADA. O não lido passou a ser POR USUÁRIO (`ConversationRead`):
  /// esta coluna não é mais lida nem escrita por nenhum caminho do sistema.
  /// Fica no banco com o dado histórico até a nova lógica provar que está de
  /// pé; a remoção é uma migration futura. Não volte a usá-la: um contador
  /// único é exatamente o bug que a leitura por usuário veio consertar.
  unreadCount        Int                @default(0)
  /// Arquivamento: a data responde "está arquivada?" (nulo = não). É
  /// ORTOGONAL ao status — não existe quinto status, e ao desarquivar a
  /// conversa volta com o status que tinha. Mensagem nova NÃO desarquiva.
  archivedAt         DateTime?
  /// Quem arquivou; nulo no arquivamento automático do número de backup.
  archivedByUserId   String?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  // Integrações futuras (CRM, processos, contratos...) — sem dependência específica
  externalReference  String?
  externalSource     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization      Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instance          WhatsAppInstance                @relation(fields: [whatsappInstanceId], references: [id], onDelete: Cascade)
  assignedUser      User?                           @relation("AssignedConversations", fields: [assignedUserId], references: [id], onDelete: SetNull)
  archivedBy        User?                           @relation("ArchivedConversations", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  department        Department?                     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  messages          Message[]
  group             WhatsAppGroup?
  internalNotes     InternalNote[]
  tags              ConversationTag[]
  assignmentHistory ConversationAssignmentHistory[]
  scheduledMessages ScheduledMessage[]
  reads             ConversationRead[]
  /// Fixadas no topo — INTERNO ao AZVCHAT, nunca propagado ao WhatsApp (ver
  /// `PinnedItem`).
  pinnedItems       PinnedItem[]
  /// Registros de idempotência de envios pela API de integração (ver
  /// `IntegrationMessageLog`). Referência frouxa: apagar a conversa não apaga
  /// o log, só zera o ponteiro.
  integrationMessageLogs IntegrationMessageLog[]
  /// Oportunidades do CRM abertas a partir desta conversa. A conversa é a
  /// FONTE do contato — o CRM não copia nome, telefone nem empresa.
  crmOpportunities       CrmOpportunity[]

  @@unique([whatsappInstanceId, externalChatId])
  @@index([organizationId, status])
  @@index([organizationId, lastMessageAt])
  /// Dashboard: conversas com atividade no período agrupadas por status, e as
  /// candidatas a atraso (não resolvidas, paradas há mais que o limite).
  @@index([organizationId, status, lastMessageAt])
  /// Inbox: não arquivadas de um recorte ordenadas por última mensagem —
  /// o archivedAt vem antes para o filtro "IS NULL" usar o mesmo índice.
  @@index([organizationId, archivedAt, lastMessageAt])
  @@map("conversations")
}

/// Até onde CADA PESSOA leu uma conversa.
///
/// Guardamos a marca (o instante da última mensagem lida), e não um contador
/// por pessoa: contador exigiria escrever uma linha por usuário a cada
/// mensagem recebida — num grupo visível para dez atendentes, dez escritas
/// por mensagem. Com a marca, ler custa uma escrita só de quem leu, e o
/// número de não lidas é DERIVADO na consulta.
///
/// Linha ausente significa "nunca leu": nada é semeado, e conversa que
/// ninguém abriu aparece inteira como não lida — que é o estado seguro.
model ConversationRead {
  id                String   @id @default(uuid())
  organizationId    String
  conversationId    String
  userId            String
  /// Instante da última mensagem lida. Só avança sozinho — se a pessoa rolar
  /// para cima e reler mensagens antigas, a marca não recua e a conversa não
  /// volta a ter não lidas. Recuar é ação explícita ("marcar como não lida").
  lastReadAt        DateTime
  /// Onde a marca parou, para referência. Opcional de propósito: quem decide
  /// a contagem é o instante, e a mensagem pode ser apagada depois.
  lastReadMessageId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadMessage Message?     @relation(fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@unique([userId, conversationId])
  @@index([conversationId])
  @@map("conversation_reads")
}

// ============================================================
// Mensagens
// ============================================================

enum MessageDirection {
  inbound
  outbound
}

enum MessageType {
  text
  image
  audio
  video
  document
  sticker
  location
  contact
  poll
  call
  other
}

enum MessageStatus {
  pending
  sent
  delivered
  read
  failed
}

model Message {
  id                String           @id @default(uuid())
  organizationId    String
  conversationId    String
  externalMessageId String?
  senderExternalId  String?
  senderName        String?
  senderPhone       String?
  direction         MessageDirection
  type              MessageType
  content           String?
  mediaUrl          String?
  mimeType          String?
  filename          String?
  quotedMessageId   String?
  timestamp         DateTime
  status            MessageStatus    @default(pending)
  sentByUserId      String?
  /// Apagada para todos (mantemos a linha para histórico/auditoria)
  deletedAt         DateTime?
  deletedByUserId   String?
  /// Última edição do texto, quando houve
  editedAt          DateTime?
  /// Dados extras por tipo (ex.: opções da enquete)
  metadata          Json?
  createdAt         DateTime         @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sentByUser   User?              @relation(fields: [sentByUserId], references: [id], onDelete: SetNull)
  reactions    MessageReaction[]
  readMarks    ConversationRead[]
  pinnedItems  PinnedItem[]
  integrationMessageLogs IntegrationMessageLog[]

  @@unique([conversationId, externalMessageId])
  @@index([conversationId, timestamp])
  @@index([organizationId, timestamp])
  /// Contagem de não lidas por usuário: mensagens RECEBIDAS de uma conversa
  /// acima de um instante. Sem a direção na chave, a varredura teria de ler
  /// também tudo o que a equipe enviou.
  @@index([conversationId, direction, timestamp])
  @@map("messages")
}

// ============================================================
// Reações às mensagens (emoji)
// ============================================================

model MessageReaction {
  id               String   @id @default(uuid())
  messageId        String
  emoji            String
  /// JID de quem reagiu (ou o número conectado, quando fromMe)
  senderExternalId String
  senderName       String?
  fromMe           Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, senderExternalId])
  @@index([messageId])
  @@map("message_reactions")
}

// ============================================================
// Notas internas (não vão para o WhatsApp)
// ============================================================

model InternalNote {
  id             String   @id @default(uuid())
  organizationId String
  conversationId String
  userId         String?
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  pinnedItems  PinnedItem[]

  @@index([conversationId])
  @@map("internal_notes")
}

// ============================================================
// Mensagens fixadas ("pin")
// ============================================================

/// Fixação é INTERNA ao AZVCHAT: destaca uma mensagem (ou nota interna) no
/// topo da conversa, só para a equipe, e NUNCA é propagada ao WhatsApp — o
/// pin do próprio WhatsApp fixa para todos os participantes do grupo, e o
/// cliente veria o escritório fixando coisas no chat dele. Por isso não usa o
/// recurso de pin do Baileys e não chama o provider.
///
/// O alvo é polimórfico (`messageId` OU `noteId`, nunca os dois — garantido
/// pela constraint `pinned_items_one_target` na migration) porque nota
/// interna também pode ser fixada, e ela não é `Message`. Sem prazo de
/// validade de propósito: link de formulário e de pasta precisa continuar no
/// topo até alguém desafixar, diferente do WhatsApp.
model PinnedItem {
  id             String   @id @default(uuid())
  organizationId String
  conversationId String
  /// Nulo quando o alvo é uma nota interna.
  messageId      String?
  /// Nulo quando o alvo é uma mensagem.
  noteId         String?
  /// Quem fixou. Nulo segue o mesmo padrão de `archivedByUserId`/
  /// `deletedByUserId`: ação de alguém que pode não existir mais no cadastro.
  pinnedByUserId String?
  pinnedAt       DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  note         InternalNote? @relation(fields: [noteId], references: [id], onDelete: Cascade)
  pinnedBy     User?         @relation(fields: [pinnedByUserId], references: [id], onDelete: SetNull)

  // NULL não colide em índice único do Postgres, então várias fixações de
  // nota (messageId nulo) e várias de mensagem (noteId nulo) convivem — cada
  // unique só impede duplicar o MESMO alvo na mesma conversa.
  @@unique([conversationId, messageId])
  @@unique([conversationId, noteId])
  // Ordena a faixa ("1 de 3") e sustenta a contagem do limite de 3.
  @@index([conversationId, pinnedAt])
  @@map("pinned_items")
}

// ============================================================
// Etiquetas
// ============================================================

model Tag {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  color          String   @default("#6366f1")
  /// Vale para a organização inteira. Com ela ligada não existe vínculo em
  /// `departments`; desligada, a etiqueta precisa de pelo menos um.
  ///
  /// "Geral" é esta flag, e não a lista vazia: se lista vazia significasse
  /// geral, excluir um departamento tornaria uma etiqueta restrita visível
  /// para todo mundo sem ninguém perceber.
  isGeneral      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments   TagDepartment[]
  conversations ConversationTag[]
  /// Usos da etiqueta no CRM: nas oportunidades, nas automações de etapa e
  /// como gatilho de criação automática de oportunidade. É a MESMA etiqueta
  /// da conversa — o CRM nunca teve lista própria.
  crmOpportunities   CrmOpportunityTag[]
  crmStageActions    CrmStageAction[] @relation("CrmStageActionTag")
  crmAutoCreatePipelines CrmPipeline[] @relation("CrmPipelineAutoCreateTag")

  // Nome único na organização inteira: a etiqueta aparece na conversa sem
  // dizer de qual departamento é, então dois "URGENTE" seriam indistinguíveis.
  @@unique([organizationId, name])
  @@index([isGeneral])
  @@map("tags")
}

/// Uma etiqueta serve a vários departamentos ao mesmo tempo: o mesmo
/// "Urgente" vale para Contábil, Fiscal e DP sem precisar de três cadastros.
model TagDepartment {
  tagId        String
  departmentId String

  tag        Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  // Cascade nas duas pontas. Excluir o departamento apaga só este vínculo —
  // a etiqueta continua existindo, some para quem não é admin e fica na tela
  // de gestão para o admin arrumar.
  @@id([tagId, departmentId])
  @@index([departmentId])
  @@map("tag_departments")
}

model ConversationTag {
  conversationId String
  tagId          String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@map("conversation_tags")
}

// ============================================================
// Histórico de atribuição de atendimento
// ============================================================

enum AssignmentAction {
  assigned
  transferred_user
  transferred_department
  unassigned
  /// Entrou no atendimento coletivo ("@todos"). Ação própria porque
  /// `assigned` significa pessoa: reaproveitá-la faria o histórico dizer
  /// "assumiu o atendimento" para uma marcação que não tem dono.
  assigned_to_all
  /// Saiu do coletivo — seja por ficar sem responsável, seja por alguém
  /// assumir (aí vem seguida de `assigned`).
  unassigned_from_all
  resolved
  reopened
}

model ConversationAssignmentHistory {
  id                String           @id @default(uuid())
  organizationId    String
  conversationId    String
  action            AssignmentAction
  fromUserId        String?
  toUserId          String?
  fromDepartmentId  String?
  toDepartmentId    String?
  performedByUserId String?
  note              String?
  createdAt         DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  performedBy  User?        @relation("PerformedAssignments", fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map("conversation_assignment_history")
}

// ============================================================
// Respostas rápidas (atalho com "/" no composer)
// ============================================================

model QuickReply {
  id             String    @id @default(uuid())
  organizationId String
  /// Atalho digitado após a barra, ex.: "bomdia" -> /bomdia
  shortcut       String
  title          String?
  content        String
  /// Vale para a organização inteira. Mesma regra da etiqueta: com ela
  /// ligada não existe vínculo em `departments`; desligada, precisa de pelo
  /// menos um.
  isGeneral      Boolean   @default(false)
  /// Mídia opcional (imagem, áudio ou vídeo) que sai junto com o texto.
  /// `mediaUrl` é a chave no MediaStorage — mesmo esquema da Message; a
  /// imagem nunca sai por URL pública, só por rota autenticada.
  mediaUrl       String?
  mediaMimeType  String?
  mediaFilename  String?
  /// Última vez que o atalho foi de fato ENVIADO pelo composer (não a
  /// edição do cadastro). É como a equipe descobre resposta parada que
  /// ninguém usa mais. Null = nunca usada desde que a coluna existe.
  lastUsedAt     DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments  QuickReplyDepartment[]
  createdBy    User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  // Atalho único na organização: "/bomdia" não pode significar duas coisas
  // diferentes dependendo de quem digita.
  @@unique([organizationId, shortcut])
  @@index([isGeneral])
  @@map("quick_replies")
}

/// O mesmo texto padrão serve a vários departamentos — ver TagDepartment.
model QuickReplyDepartment {
  quickReplyId String
  departmentId String

  quickReply QuickReply @relation(fields: [quickReplyId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([quickReplyId, departmentId])
  @@index([departmentId])
  @@map("quick_reply_departments")
}

// ============================================================
// Mensagens agendadas
// ============================================================

enum ScheduledMessageStatus {
  pending
  sent
  failed
  canceled
}

model ScheduledMessage {
  id             String                 @id @default(uuid())
  organizationId String
  conversationId String
  content        String
  scheduledFor   DateTime
  status         ScheduledMessageStatus @default(pending)
  createdById    String?
  sentMessageId  String?
  error          String?
  /// Tentativas de envio já realizadas (falhas temporárias são retentadas)
  attempts       Int                    @default(0)
  /// Follow-up do CRM: qual oportunidade agendou esta mensagem. Nulo = o
  /// agendamento normal do composer, feito por uma pessoa.
  ///
  /// A coluna existe para o cancelamento automático saber o que é dele: quando
  /// o cliente responde, ou o card sai da etapa, só os agendamentos DAQUELA
  /// oportunidade são cancelados — o compromisso que uma pessoa marcou à mão
  /// com o cliente nunca é desmarcado pelo CRM. O motor de envio continua
  /// sendo um só (`services/scheduler.ts`): o CRM não tem agendador próprio.
  crmOpportunityId String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  crmOpportunity CrmOpportunity? @relation(fields: [crmOpportunityId], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@index([conversationId])
  @@index([crmOpportunityId, status])
  @@map("scheduled_messages")
}

// ============================================================
// Auditoria
// ============================================================

/// O que cada perfil PODE FAZER nesta organização, por par (papel, ação).
///
/// Só grava o que difere do catálogo: AUSÊNCIA DE LINHA significa o padrão
/// de `PERMISSION_ACTIONS` (@azvchat/shared). Gravar as ~25 linhas por papel
/// de saída congelaria os padrões no banco — mudar um padrão no código
/// deixaria de valer para quem já existe, e o catálogo perderia o sentido.
///
/// `admin` nunca tem linha aqui (constraint no banco): administrador passa
/// por cima de tudo, senão a organização conseguiria se trancar do lado de
/// fora sem ninguém para religar.
///
/// PERMISSÃO É AÇÃO, NUNCA ALCANCE: nada nesta tabela decide quais conversas
/// alguém enxerga — isso continua saindo de lib/access.ts, pelos vínculos de
/// número e departamento.
model RolePermission {
  id             String   @id @default(uuid())
  organizationId String
  role           UserRole
  /// Nome técnico da ação no catálogo. Texto, e não enum: ação some do
  /// código sem exigir migration, e a linha órfã é ignorada em silêncio.
  action         String
  allowed        Boolean
  /// Quem mudou por último — a tela mostra ao lado da chave alterada.
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy    User?        @relation("RolePermissionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, role, action])
  @@index([organizationId])
  @@map("role_permissions")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ============================================================
// Parâmetros de atendimento (SLA e expediente)
// ============================================================

/// Política de atendimento do escritório: em quanto tempo o cliente precisa
/// ser respondido e em que horários esse tempo corre. Fica no banco, e não
/// no código, porque muda sem deploy — e o dashboard lê a cada requisição.
///
/// Uma linha por organização hoje. A tabela filha aponta para esta, e não
/// para a organização: no dia em que existir parâmetro por departamento,
/// basta uma nova linha aqui. Nenhuma coluna de departamento agora.
model AttendanceSettings {
  id                      String   @id @default(uuid())
  organizationId          String   @unique
  /// Minutos sem resposta, contados só dentro do expediente, para o
  /// atendimento entrar como atrasado.
  responseLimitMinutes    Int      @default(30)
  /// Fuso do escritório. Todo corte de data do dashboard usa este fuso,
  /// nunca o UTC do servidor.
  timezone                String   @default("America/Sao_Paulo")
  /// Liga a restrição de horário de login. Desligada por padrão: ligada de
  /// saída, um deploy trancaria do lado de fora quem já estava trabalhando.
  loginRestrictionEnabled Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessHours AttendanceBusinessHours[]
  loginHours    AttendanceLoginHours[]

  @@map("attendance_settings")
}

/// Expediente de um dia da semana. Sete linhas por configuração — cada dia
/// se liga e desliga sozinho, porque o escritório pode passar a atender
/// sábado de manhã sem mexer nos outros dias.
model AttendanceBusinessHours {
  id         String  @id @default(uuid())
  settingsId String
  /// 0 = domingo ... 6 = sábado, igual a `Date#getDay()` e a `EXTRACT(DOW)`.
  weekday    Int
  active     Boolean @default(true)
  /// "HH:MM" no fuso da configuração. Texto, e não `time`, porque é
  /// exatamente o formato que a tela envia e que o cálculo consome.
  startTime  String  @default("08:00")
  endTime    String  @default("18:00")

  settings AttendanceSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, weekday])
  @@map("attendance_business_hours")
}

/// Janela de login de um dia da semana, aplicada só a quem não é supervisor.
/// Tabela separada do expediente porque as duas faixas não são a mesma coisa:
/// o expediente mede o atraso do dashboard, esta aqui diz quem consegue
/// entrar. Sete linhas por configuração, cada dia ligando sozinho.
model AttendanceLoginHours {
  id         String  @id @default(uuid())
  settingsId String
  /// 0 = domingo ... 6 = sábado, igual a `Date#getDay()` e a `EXTRACT(DOW)`.
  weekday    Int
  /// Dia desligado é dia sem login nenhum para quem não é supervisor.
  active     Boolean @default(true)
  /// "HH:MM" no fuso da configuração, mesmo formato do expediente.
  startTime  String  @default("07:00")
  endTime    String  @default("19:00")

  settings AttendanceSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, weekday])
  @@map("attendance_login_hours")
}

// ============================================================
// Integração de envio para sistemas externos (token de máquina)
// ============================================================

/// Token de integração: credencial de MÁQUINA para outro sistema do escritório
/// disparar UMA mensagem de WhatsApp (ex.: confirmação de agendamento). Não é
/// sessão de usuário — a rota de envio tem guard próprio, fora de `auth.ts`,
/// e não passa por `requireRole`.
///
/// Guardamos só o HASH do token (`tokenHash`, sha256): o valor em claro é
/// mostrado uma única vez, na criação, e nunca mais. Cada token é amarrado a
/// EXATAMENTE uma instância (`whatsappInstanceId`): um token vazado manda
/// mensagem só por aquele número. Revogar é `active = false`, nunca apagar —
/// o histórico de uso continua de pé.
model IntegrationToken {
  id                 String    @id @default(uuid())
  organizationId     String
  name               String
  /// Prefixo visível ("azv_a1b2c3d4"), para a tela identificar o token sem
  /// nunca guardar o segredo.
  tokenPrefix        String
  /// sha256 do token inteiro — a autenticação é igualdade por este índice.
  tokenHash          String    @unique
  whatsappInstanceId String
  active             Boolean   @default(true)
  /// Quem criou. Nulo = o criador não existe mais no cadastro; o token
  /// continua válido, porque pertence à integração, não à pessoa.
  createdById        String?
  lastUsedAt         DateTime?
  usageCount         Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instance     WhatsAppInstance        @relation(fields: [whatsappInstanceId], references: [id], onDelete: Cascade)
  createdBy    User?                   @relation("IntegrationTokenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  messageLogs  IntegrationMessageLog[]

  @@index([organizationId])
  @@index([whatsappInstanceId])
  @@map("integration_tokens")
}

/// Registro de envio por chave de idempotência. Quando o sistema externo tenta
/// de novo por timeout, a MESMA chave dentro de 24h não reenvia — devolve o
/// resultado do envio original (conversa, mensagem, telefone normalizado).
/// Uma linha por (token, chave); reuso após 24h sobrescreve a linha e a janela
/// anda junto. Conversa/mensagem são referência frouxa (SET NULL): podem ser
/// apagadas sem apagar o registro.
model IntegrationMessageLog {
  id                 String   @id @default(uuid())
  integrationTokenId String
  idempotencyKey     String
  conversationId     String?
  messageId          String?
  normalizedPhone    String
  status             String
  createdAt          DateTime @default(now())

  token        IntegrationToken @relation(fields: [integrationTokenId], references: [id], onDelete: Cascade)
  conversation Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message      Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([integrationTokenId, idempotencyKey])
  @@index([integrationTokenId, createdAt])
  @@map("integration_message_logs")
}

// ============================================================
// CRM — funil de oportunidades sobre o atendimento
// ============================================================

/// Funil de vendas. É só a COLUNA DE ETAPAS e a regra de quem usa: contato,
/// conversa, etiqueta, responsável e departamento continuam nas tabelas de
/// sempre, e nada aqui os duplica.
///
/// A regra de departamento é a MESMA de `Tag` e `QuickReply`, de propósito:
/// `isGeneral` liga o funil para a organização inteira; desligada, ele
/// precisa de pelo menos um departamento em `departments`. Lista vazia não
/// significa geral — excluir um departamento tornaria um funil restrito
/// visível para todo mundo sem ninguém perceber (ver `lib/department-resource.ts`).
model CrmPipeline {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  /// Cor de identificação do funil na tela (hex). Dado de cadastro, não tema.
  color          String   @default("#102a4c")
  /// Funil desligado some dos seletores mas mantém o histórico de pé — o
  /// mesmo motivo de revogar token em vez de apagar.
  isActive       Boolean  @default(true)
  /// Vale para todos os departamentos (ver acima).
  isGeneral      Boolean  @default(false)
  /// Ordem na lista de funis.
  position       Int      @default(0)
  /// Funil que abre quando ninguém escolheu nenhum. Um por organização, mas
  /// sem constraint: a leitura pega o primeiro, então dois marcados degradam
  /// para "abre o de menor posição", nunca para erro na cara do usuário.
  isDefault      Boolean  @default(false)
  /// Etiqueta que CRIA oportunidade sozinha: pendurada numa conversa, o
  /// sistema abre um card na primeira etapa deste funil. Nulo = criação
  /// automática desligada. Reusa a etiqueta que o escritório já tem — não
  /// existe gatilho paralelo nem lista de palavras-chave.
  autoCreateTagId String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  autoCreateTag Tag?                    @relation("CrmPipelineAutoCreateTag", fields: [autoCreateTagId], references: [id], onDelete: SetNull)
  createdBy     User?                   @relation("CrmPipelineCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  departments   CrmPipelineDepartment[]
  stages        CrmStage[]
  opportunities CrmOpportunity[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("crm_pipelines")
}

/// O mesmo funil serve a vários departamentos — ver `TagDepartment`, que é o
/// modelo copiado aqui de propósito. Nada de um funil clonado por área.
model CrmPipelineDepartment {
  pipelineId   String
  departmentId String

  pipeline   CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  department Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([pipelineId, departmentId])
  @@index([departmentId])
  @@map("crm_pipeline_departments")
}

/// O que a etapa significa para o funil, independente do nome dado a ela.
/// Sem o tipo, "ganhou" e "perdeu" teriam de ser adivinhados pelo nome da
/// coluna — e um funil com a coluna "Fechamos!" quebraria em silêncio.
enum CrmStageType {
  open
  in_progress
  won
  lost
}

/// Coluna do Kanban.
model CrmStage {
  id             String       @id @default(uuid())
  organizationId String
  pipelineId     String
  name           String
  /// Ordem da coluna no quadro (espaçada, ver CRM_POSITION_STEP no shared).
  position       Int          @default(0)
  color          String       @default("#64748b")
  /// Chance de fechamento desta etapa, 0 a 100. Alimenta o valor ponderado.
  probability    Int          @default(0)
  type           CrmStageType @default(in_progress)
  /// Dias para a oportunidade ser considerada PARADA nesta etapa. Nulo = sem
  /// prazo. Derivado de `stageEnteredAt` na leitura — não existe processo
  /// varrendo a tabela para marcar atraso, que mentiria se caísse.
  slaDays        Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline      CrmPipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  actions       CrmStageAction[]
  opportunities CrmOpportunity[]

  @@unique([pipelineId, name])
  @@index([pipelineId, position])
  @@map("crm_stages")
}

enum CrmStageActionTrigger {
  enter
  leave
}

/// O que a ação FAZ. Toda opção já existia no AZVCHAT antes do CRM: etiqueta,
/// responsável, departamento, nota interna e mensagem agendada. Nenhum motor
/// novo — `schedule_message` cria uma `ScheduledMessage` de verdade, enviada
/// pelo mesmo `services/scheduler.ts` das agendadas do composer.
enum CrmStageActionType {
  add_tag
  remove_tag
  assign_user
  change_department
  create_activity
  schedule_message
  internal_note
}

/// Automação de etapa: o que acontece ao ENTRAR ou SAIR de uma coluna.
///
/// Uma tabela com colunas opcionais em vez de JSON solto: o alvo de cada ação
/// é uma chave estrangeira de verdade (etiqueta, usuário, departamento), então
/// excluir a etiqueta apaga a ação junto em vez de deixar uma automação
/// apontando para o nada e falhando toda vez que o card se mexe.
model CrmStageAction {
  id           String                @id @default(uuid())
  stageId      String
  trigger      CrmStageActionTrigger @default(enter)
  type         CrmStageActionType
  /// Alvo de `add_tag` / `remove_tag` — a etiqueta que o escritório já usa.
  tagId        String?
  /// Alvo de `assign_user`.
  userId       String?
  /// Alvo de `change_department`.
  departmentId String?
  /// `schedule_message`: quanto tempo depois da entrada a mensagem sai.
  /// `create_activity`: prazo da atividade. Em minutos, para caber "2 horas"
  /// e "3 dias" no mesmo campo.
  delayMinutes Int                   @default(0)
  /// Texto da mensagem agendada, da nota interna ou título da atividade.
  content      String?
  position     Int                   @default(0)
  createdAt    DateTime              @default(now())

  stage      CrmStage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  tag        Tag?        @relation("CrmStageActionTag", fields: [tagId], references: [id], onDelete: Cascade)
  user       User?       @relation("CrmStageActionUser", fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation("CrmStageActionDepartment", fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([stageId, trigger])
  @@map("crm_stage_actions")
}

enum CrmOpportunityStatus {
  open
  won
  lost
}

/// Serviço vendido pelo escritório ("Abertura de empresa", "Certificado
/// digital"). Catálogo simples de propósito: sem preço de tabela, sem
/// tributação, sem estoque — é rótulo para agrupar o relatório, e a estrutura
/// já fica pronta para virar catálogo de verdade se o dia chegar.
model CrmProduct {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  /// Valor sugerido, só para preencher o formulário. A oportunidade guarda o
  /// valor dela — mudar a tabela não pode reescrever negociação fechada.
  defaultValue   Decimal? @db.Decimal(12, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunities CrmOpportunity[]

  @@unique([organizationId, name])
  @@map("crm_products")
}

/// Motivo de perda. Tabela e não texto livre porque é isto que vira gráfico:
/// "preço" digitado de seis jeitos diferentes não se agrupa.
model CrmLossReason {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  active         Boolean  @default(true)
  position       Int      @default(0)
  createdAt      DateTime @default(now())

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunities CrmOpportunity[]

  @@unique([organizationId, name])
  @@map("crm_loss_reasons")
}

/// A oportunidade: uma intenção de negócio com um cliente.
///
/// O CONTATO NÃO É COPIADO PARA CÁ. `conversationId` aponta para a conversa
/// do WhatsApp que já existe, e é dela que saem nome, telefone, foto, empresa
/// do Azevedo-OS e histórico. Um cadastro de cliente aqui seria uma segunda
/// base de contatos divergindo da primeira no dia seguinte. Os campos
/// `contactName`/`contactPhone` existem só para a oportunidade avulsa (lead
/// que ainda não tem conversa) e para o card não precisar de join na lista —
/// quando há conversa, ela vence sempre na exibição.
///
/// A mesma pessoa pode ter várias oportunidades ao mesmo tempo (abertura de
/// empresa, certificado, consultoria), cada uma com histórico próprio. O que
/// o banco impede, por índice parcial criado na migration, é a MESMA conversa
/// ter duas oportunidades ABERTAS no MESMO funil — que é o caso de duplicata
/// de verdade (dois cliques no botão, dois webhooks, automação repetida).
model CrmOpportunity {
  id             String               @id @default(uuid())
  organizationId String
  pipelineId     String
  stageId        String
  title          String
  /// A conversa do WhatsApp. Nulo = lead avulso, ainda sem conversa.
  conversationId String?
  /// Telefone/nome do lead avulso, ou a cópia de exibição do contato.
  contactName    String?
  contactPhone   String?
  assignedUserId String?
  /// Departamento da oportunidade — herdado da conversa na criação. É por ele
  /// (mais o responsável) que o recorte de visibilidade acontece, com a mesma
  /// forma de `conversationScope`. Nulo = sem departamento, visível a quem
  /// alcança a conversa, igual à conversa sem departamento.
  departmentId   String?
  productId      String?
  value          Decimal              @default(0) @db.Decimal(12, 2)
  discount       Decimal?             @db.Decimal(12, 2)
  /// Chance de fechamento definida à mão. Nulo = vale a probabilidade da
  /// etapa. Mover de etapa NÃO apaga o ajuste manual: apagar faria a correção
  /// de quem está negociando sumir no meio de um arrasto.
  probability    Int?
  expectedCloseDate DateTime?
  /// Chave de `CRM_ORIGINS` (@azvchat/shared). Texto e não enum: origem nova
  /// (uma campanha, um evento) não pode exigir migration.
  origin         String?
  status         CrmOpportunityStatus @default(open)
  lossReasonId   String?
  lossNote       String?
  /// Valor efetivamente fechado, registrado no ganho. Separado de `value`
  /// porque o estimado é o que se previu e este é o que aconteceu — sobrescrever
  /// um com o outro apagaria a diferença que o relatório mede.
  closedValue    Decimal?             @db.Decimal(12, 2)
  closedAt       DateTime?
  notes          String?
  /// Ordem dentro da coluna, espaçada (ver CRM_POSITION_STEP no shared).
  position       Float                @default(1000)
  /// Quando entrou na etapa atual — é daqui que sai "2 dias nesta etapa" e o
  /// alerta de oportunidade parada.
  stageEnteredAt DateTime             @default(now())
  /// Última mensagem do cliente na conversa vinculada. Alimenta o card e o
  /// cancelamento de follow-up.
  lastInteractionAt DateTime?
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     CrmPipeline            @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage        CrmStage               @relation(fields: [stageId], references: [id], onDelete: Restrict)
  conversation Conversation?          @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignedUser User?                  @relation("CrmAssignedOpportunities", fields: [assignedUserId], references: [id], onDelete: SetNull)
  department   Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  product      CrmProduct?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  lossReason   CrmLossReason?         @relation(fields: [lossReasonId], references: [id], onDelete: SetNull)
  createdBy    User?                  @relation("CrmCreatedOpportunities", fields: [createdById], references: [id], onDelete: SetNull)
  tags         CrmOpportunityTag[]
  activities   CrmActivity[]
  events       CrmOpportunityEvent[]
  /// Follow-ups criados por este card (ver `ScheduledMessage.crmOpportunityId`).
  followUps    ScheduledMessage[]

  /// Kanban: uma coluna de um funil, ordenada.
  @@index([organizationId, pipelineId, stageId, position])
  @@index([organizationId, status, updatedAt])
  @@index([conversationId])
  @@index([assignedUserId])
  @@index([departmentId])
  @@map("crm_opportunities")
}

/// Etiqueta na oportunidade — a MESMA `Tag` da conversa. Etiqueta paralela
/// obrigaria o escritório a manter duas listas com os mesmos nomes.
model CrmOpportunityTag {
  opportunityId String
  tagId         String
  createdAt     DateTime @default(now())

  opportunity CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  tag         Tag            @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([opportunityId, tagId])
  @@index([tagId])
  @@map("crm_opportunity_tags")
}

enum CrmActivityType {
  call
  whatsapp
  meeting
  proposal
  document
  billing
  followup
  task
  other
}

enum CrmActivityStatus {
  pending
  done
  canceled
}

enum CrmActivityPriority {
  low
  normal
  high
}

/// Compromisso da equipe dentro de uma oportunidade ("ligar amanhã às 10h").
///
/// "Atrasada" NÃO é status gravado: é a leitura do relógio sobre uma pendente
/// com prazo vencido. Gravar exigiria um processo varrendo a tabela na virada
/// da hora, e uma queda dele faria a tela dizer que não há nada atrasado.
model CrmActivity {
  id             String              @id @default(uuid())
  organizationId String
  opportunityId  String
  type           CrmActivityType     @default(task)
  title          String
  description    String?
  assignedUserId String?
  dueAt          DateTime
  priority       CrmActivityPriority @default(normal)
  status         CrmActivityStatus   @default(pending)
  completedAt    DateTime?
  completedById  String?
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity  CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  assignedUser User?          @relation("CrmAssignedActivities", fields: [assignedUserId], references: [id], onDelete: SetNull)
  completedBy  User?          @relation("CrmCompletedActivities", fields: [completedById], references: [id], onDelete: SetNull)

  /// A agenda: pendentes por prazo, que é a pergunta da tela de Atividades.
  @@index([organizationId, status, dueAt])
  @@index([opportunityId, status, dueAt])
  @@index([assignedUserId, status, dueAt])
  @@map("crm_activities")
}

/// Linha do tempo da oportunidade. Um tipo por FATO, e não texto livre: o
/// relatório de motivos e o filtro "movidas no período" leem daqui, e texto
/// livre não se agrupa.
enum CrmEventType {
  created
  stage_changed
  assignee_changed
  department_changed
  value_changed
  tag_added
  tag_removed
  activity_created
  activity_done
  follow_up_scheduled
  follow_up_canceled
  client_replied
  won
  lost
  reopened
  updated
  note
}

model CrmOpportunityEvent {
  id                String       @id @default(uuid())
  organizationId    String
  opportunityId     String
  type              CrmEventType
  /// Nulo = ação do sistema (automação de etapa, resposta do cliente), mesmo
  /// padrão de `archivedByUserId`.
  performedByUserId String?
  fromStageId       String?
  toStageId         String?
  fromUserId        String?
  toUserId          String?
  /// Frase pronta para a timeline, montada por quem registrou o evento.
  description       String?
  /// Contexto extra por tipo (valor antes/depois, motivo da perda...).
  metadata          Json?
  createdAt         DateTime     @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity  CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  performedBy  User?          @relation("CrmPerformedEvents", fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([opportunityId, createdAt])
  @@index([organizationId, type, createdAt])
  @@map("crm_opportunity_events")
}
