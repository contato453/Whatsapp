generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Organização (preparação multi-tenant / SaaS)
// ============================================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  departments         Department[]
  whatsappInstances   WhatsAppInstance[]
  conversations       Conversation[]
  contacts            Contact[]
  groups              WhatsAppGroup[]
  messages            Message[]
  tags                Tag[]
  internalNotes       InternalNote[]
  assignmentHistories ConversationAssignmentHistory[]
  auditLogs           AuditLog[]
  quickReplies        QuickReply[]
  scheduledMessages   ScheduledMessage[]
  conversationReads   ConversationRead[]
  attendanceSettings  AttendanceSettings?
  rolePermissions     RolePermission[]
  personProfiles      PersonProfile[]
  pinnedItems         PinnedItem[]
  integrationTokens   IntegrationToken[]
  followUpRules       FollowUpRule[]
  followUpExecutions  FollowUpExecution[]
  aiProviderConfigs   AiProviderConfig[]
  aiSettings          AiSettings?
  aiAgents            AiAgent[]
  aiKnowledgeSources  AiKnowledgeSource[]
  aiAutomations       AiAutomation[]
  aiSessions          AiSession[]
  aiUsageLogs         AiUsageLog[]

  @@map("organizations")
}

// ============================================================
// Usuários / Atendentes
// ============================================================

enum UserRole {
  admin
  supervisor
  agent
}

enum UserStatus {
  active
  inactive
}

/// Som do aviso de mensagem recebida. `none` é silêncio escolhido pela
/// pessoa — nunca o estado inicial, que é `sound_1`.
enum NotificationSound {
  none
  sound_1
  sound_2
  sound_3
}

/// Volume do aviso de mensagem recebida, em três degraus perceptivelmente
/// distintos (o ganho de cada um é decidido no frontend, que toca o som).
enum NotificationVolume {
  low
  medium
  high
}

model User {
  id                 String             @id @default(uuid())
  organizationId     String
  name               String
  email              String             @unique
  passwordHash       String
  role               UserRole           @default(agent)
  status             UserStatus         @default(active)
  avatarUrl          String?
  /// Prefixa as mensagens enviadas com o nome do atendente ("Fulano:")
  signMessages       Boolean            @default(false)
  /// Som tocado quando chega mensagem recebida — preferência de cada pessoa
  notificationSound  NotificationSound  @default(sound_1)
  /// Volume do som de notificação
  notificationVolume NotificationVolume @default(medium)
  /// Último login bem-sucedido — null enquanto o usuário nunca entrou
  lastLoginAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization          Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[]                  @relation("AssignedConversations")
  archivedConversations Conversation[]                  @relation("ArchivedConversations")
  sentMessages          Message[]
  internalNotes         InternalNote[]
  performedAssignments  ConversationAssignmentHistory[] @relation("PerformedAssignments")
  auditLogs             AuditLog[]
  quickReplies          QuickReply[]
  scheduledMessages     ScheduledMessage[]
  whatsappAccess        UserWhatsAppInstance[]
  departmentAccess      UserDepartment[]
  defaultForDepartments Department[]                    @relation("DepartmentDefaultAssignee")
  defaultForInstances   WhatsAppInstance[]              @relation("InstanceDefaultAssignee")
  permissionChanges     RolePermission[]                @relation("RolePermissionUpdatedBy")
  conversationReads     ConversationRead[]
  pinnedItems           PinnedItem[]
  integrationTokens     IntegrationToken[]              @relation("IntegrationTokenCreatedBy")
  followUpRulesCreated  FollowUpRule[]                  @relation("FollowUpRuleCreatedBy")
  followUpLogActions    FollowUpExecutionLog[]          @relation("FollowUpExecutionLogActor")
  aiAgentsCreated       AiAgent[]                       @relation("AiAgentCreatedBy")
  aiAgentsUpdated       AiAgent[]                       @relation("AiAgentUpdatedBy")
  aiAgentVersions       AiAgentVersion[]                @relation("AiAgentVersionCreatedBy")
  aiHandoffTargets      AiAgent[]                       @relation("AiAgentHandoffAssignee")
  aiSessionsEnded       AiSession[]                     @relation("AiSessionEndedBy")
  aiSettingsUpdated     AiSettings[]                    @relation("AiSettingsUpdatedBy")
  aiKnowledgeCreated    AiKnowledgeSource[]             @relation("AiKnowledgeCreatedBy")

  @@index([organizationId])
  @@map("users")
}

// ============================================================
// Departamentos
// ============================================================

model Department {
  id                String   @id @default(uuid())
  organizationId    String
  name              String
  description       String?
  color             String?
  /// Responsável padrão: assume as conversas que entram neste departamento
  /// sem ninguém atribuído. Precisa ter acesso ao próprio departamento.
  defaultAssigneeId String?
  /// Departamento INTERNO: as conversas dele não entram em número nenhum
  /// (dashboard, atrasados agora e relatório por atendente). Existe porque
  /// grupo interno da equipe não é atendimento a cliente, e contá-lo como
  /// tal inflava o painel — principalmente o "Atrasados agora", já que a
  /// última mensagem de um grupo interno é quase sempre "do cliente" aos
  /// olhos do sistema e ninguém "responde" a ela.
  /// **Não é arquivamento**: a conversa continua na lista, continua contando
  /// não lidas, tocando o som e piscando o título. O que muda é só a
  /// contagem — visibilidade não é tocada em lugar nenhum.
  isInternal        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultAssignee   User?                    @relation("DepartmentDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  conversations     Conversation[]
  userAccess        UserDepartment[]
  instances         WhatsAppInstance[]
  tagLinks          TagDepartment[]
  quickReplyLinks   QuickReplyDepartment[]
  followUpRuleLinks FollowUpRuleDepartment[]
  aiAgentLinks      AiAgentDepartment[]
  aiHandoffAgents   AiAgent[]                @relation("AiAgentHandoffDepartment")
  aiAutomations     AiAutomation[]
  aiUsageLogs       AiUsageLog[]

  @@unique([organizationId, name])
  @@map("departments")
}

// ============================================================
// Instâncias de WhatsApp (multi-número)
// ============================================================

enum InstanceStatus {
  disconnected
  connecting
  qr_required
  connected
  reconnecting
  error
}

model WhatsAppInstance {
  id                  String         @id @default(uuid())
  organizationId      String
  name                String
  phoneNumber         String?
  /// Departamento em que as conversas deste número entram por padrão.
  departmentId        String?
  /// Responsável padrão do número: assume as conversas que chegam sem
  /// ninguém atribuído e que o departamento não resolveu. É o caso do
  /// número dedicado a uma pessoa, que não passa por departamento.
  defaultAssigneeId   String?
  /// Número de backup: existe só para o caso de o principal ser banido.
  /// Ligado, toda conversa nova deste número já nasce arquivada — sem isso o
  /// chip reserva duplicaria a Inbox e todos os números do dashboard.
  isBackup            Boolean        @default(false)
  status              InstanceStatus @default(disconnected)
  provider            String         @default("qrcode")
  sessionId           String         @unique @default(uuid())
  lastConnectionAt    DateTime?
  lastDisconnectionAt DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department        Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  defaultAssignee   User?                  @relation("InstanceDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  conversations     Conversation[]
  groups            WhatsAppGroup[]
  contacts          Contact[]
  userAccess        UserWhatsAppInstance[]
  integrationTokens IntegrationToken[]
  followUpRules     FollowUpRule[]
  aiAutomations     AiAutomation[]

  @@index([organizationId])
  @@index([departmentId])
  @@index([defaultAssigneeId])
  @@map("whatsapp_instances")
}

/// Quais números de WhatsApp cada usuário enxerga.
/// Sem nenhuma linha = sem acesso a conversa nenhuma (admin é a exceção).
model UserWhatsAppInstance {
  userId             String
  whatsappInstanceId String
  createdAt          DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  instance WhatsAppInstance @relation(fields: [whatsappInstanceId], references: [id], onDelete: Cascade)

  @@id([userId, whatsappInstanceId])
  @@index([whatsappInstanceId])
  @@map("user_whatsapp_instances")
}

/// Em quais departamentos cada usuário atua.
/// Sem nenhuma linha = sem acesso a conversa nenhuma (admin é a exceção).
model UserDepartment {
  userId       String
  departmentId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@index([departmentId])
  @@map("user_departments")
}

// ============================================================
// Contatos
// ============================================================

model Contact {
  id                 String   @id @default(uuid())
  organizationId     String
  whatsappInstanceId String
  externalId         String
  phoneNumber        String?
  name               String?
  pushName           String?
  avatarUrl          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instance     WhatsAppInstance @relation(fields: [whatsappInstanceId], references: [id], onDelete: Cascade)

  @@unique([whatsappInstanceId, externalId])
  @@index([organizationId, phoneNumber])
  @@map("contacts")
}

// ============================================================
// Grupos (entidade de primeira classe)
// ============================================================

model WhatsAppGroup {
  id                 String    @id @default(uuid())
  organizationId     String
  whatsappInstanceId String
  externalId         String
  name               String
  description        String?
  imageUrl           String?
  participantCount   Int       @default(0)
  conversationId     String?   @unique
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instance     WhatsAppInstance   @relation(fields: [whatsappInstanceId], references: [id], onDelete: Cascade)
  conversation Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  participants GroupParticipant[]

  @@unique([whatsappInstanceId, externalId])
  @@map("whatsapp_groups")
}

/// Papel da pessoa dentro do cliente, marcado pela equipe.
///
/// Não confundir com `isAdmin`: aquele é administrador do GRUPO no WhatsApp e
/// vem do sync; este é atributo de cadastro e só muda por ação de gente.
enum ParticipantClientRole {
  partner
  administrative
}

model GroupParticipant {
  id                String                 @id @default(uuid())
  groupId           String
  externalContactId String
  phoneNumber       String
  /// Nome que vem do WhatsApp (perfil ou agenda do celular conectado).
  name              String?
  /// Nome definido pela equipe — ganha do `name` na exibição.
  customName        String?
  /// Sócio ou contato administrativo do cliente; null = sem marcação.
  /// Não confundir com `isAdmin`, que é administrador do grupo no WhatsApp
  /// e vem do sync. Desde que o texto livre "sócio" saiu da conversa, esta
  /// é a única marcação de quem representa o cliente do lado do WhatsApp.
  clientRole        ParticipantClientRole?
  isAdmin           Boolean                @default(false)
  isSuperAdmin      Boolean                @default(false)
  /// Chave do arquivo da foto no storage (null = sem foto conhecida)
  avatarUrl         String?
  /// Última tentativa de buscar a foto — evita reconsultar o WhatsApp toda hora
  avatarCheckedAt   DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  group WhatsAppGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, externalContactId])
  @@map("group_participants")
}

/// O que a equipe sabe sobre UMA PESSOA do WhatsApp, único na organização.
///
/// A identidade saiu da linha do grupo (`GroupParticipant`) para cá porque a
/// mesma pessoa participa de vários grupos do mesmo cliente (Geral, Contábil,
/// Fiscal, DP): editar grupo a grupo obrigava a repetir a correção, e na
/// prática ninguém repetia — o dado ficava certo num lugar e errado nos
/// outros. `GroupParticipant` continua com o que é do GRUPO (participação,
/// isAdmin, foto); o que é da PESSOA (nome dado pela equipe, papel no
/// cliente) mora aqui.
///
/// Não é o `Contact`: aquele é por número conectado (`@@unique(instanceId,
/// externalId)`), vem do sync da agenda e só existe para quem está nela. O
/// registro da pessoa precisa ser único na ORGANIZAÇÃO e existir para
/// qualquer participante — inclusive `@lid` fora de qualquer agenda.
///
/// LINHA EXISTENTE = a equipe já decidiu no nível da pessoa, e os valores
/// dela valem MESMO QUANDO NULOS (limpar o nome é decisão, não ausência).
/// Linha ausente = vale o legado por grupo, que ficou nas colunas antigas.
model PersonProfile {
  id             String                 @id @default(uuid())
  organizationId String
  /// Identificador da pessoa no WhatsApp (JID normalizado) — o mesmo valor
  /// de `GroupParticipant.externalContactId`. Pode ser `@s.whatsapp.net` ou
  /// `@lid`; o LID é estável, então ele também unifica entre grupos.
  externalId     String
  /// Telefone conhecido (dígitos), copiado da participação. Serve de ponte
  /// para a conversa individual quando ela usa outro endereçamento do mesmo
  /// número. NUNCA é chave de fusão de registros — só de exibição.
  phoneNumber    String?
  /// Nome definido pela equipe — vale em todos os grupos e telas.
  customName     String?
  /// Papel da pessoa dentro do cliente (sócio/administrativo), da equipe.
  clientRole     ParticipantClientRole?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, externalId])
  @@index([organizationId, phoneNumber])
  @@map("person_profiles")
}

// ============================================================
// Conversas
// ============================================================

enum ConversationType {
  individual
  group
}

enum ConversationStatus {
  open
  waiting_client
  waiting_internal
  resolved
}

model Conversation {
  id                 String             @id @default(uuid())
  organizationId     String
  whatsappInstanceId String
  externalChatId     String
  type               ConversationType
  /// Nome que vem do WhatsApp (nome do grupo ou do perfil). O sync sobrescreve.
  title              String
  /// Nome definido pela equipe. Tem prioridade sobre `title` na exibição e
  /// nunca é tocado pela sincronização.
  customTitle        String?
  profilePicture     String?
  status             ConversationStatus @default(open)
  assignedUserId     String?
  /// Atribuição coletiva ("@todos"): o atendimento é de todo o departamento,
  /// por decisão, e não de uma pessoa. Convive com `assignedUserId` NULO de
  /// propósito — a visibilidade já sai da regra existente (o atendente vê o
  /// que é dele mais o que está sem responsável), então nada em access.ts
  /// muda e não há usuário fictício "@todos" no banco. A coluna serve para
  /// distinguir o coletivo da conversa órfã esperando alguém pegar: as duas
  /// aparecem igual na Inbox, mas só a órfã deve entrar nas contagens de
  /// "sem responsável" e receber responsável padrão.
  /// Constraint no banco garante que marcação e responsável nunca coexistem.
  assignedToAll      Boolean            @default(false)
  departmentId       String?
  /// APOSENTADA. O não lido passou a ser POR USUÁRIO (`ConversationRead`):
  /// esta coluna não é mais lida nem escrita por nenhum caminho do sistema.
  /// Fica no banco com o dado histórico até a nova lógica provar que está de
  /// pé; a remoção é uma migration futura. Não volte a usá-la: um contador
  /// único é exatamente o bug que a leitura por usuário veio consertar.
  unreadCount        Int                @default(0)
  /// Arquivamento: a data responde "está arquivada?" (nulo = não). É
  /// ORTOGONAL ao status — não existe quinto status, e ao desarquivar a
  /// conversa volta com o status que tinha. Mensagem nova NÃO desarquiva.
  archivedAt         DateTime?
  /// Quem arquivou; nulo no arquivamento automático do número de backup.
  archivedByUserId   String?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  // Integrações futuras (CRM, processos, contratos...) — sem dependência específica
  externalReference  String?
  externalSource     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization           Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instance               WhatsAppInstance                @relation(fields: [whatsappInstanceId], references: [id], onDelete: Cascade)
  assignedUser           User?                           @relation("AssignedConversations", fields: [assignedUserId], references: [id], onDelete: SetNull)
  archivedBy             User?                           @relation("ArchivedConversations", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  department             Department?                     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  messages               Message[]
  group                  WhatsAppGroup?
  internalNotes          InternalNote[]
  tags                   ConversationTag[]
  assignmentHistory      ConversationAssignmentHistory[]
  scheduledMessages      ScheduledMessage[]
  reads                  ConversationRead[]
  /// Fixadas no topo — INTERNO ao AZVCHAT, nunca propagado ao WhatsApp (ver
  /// `PinnedItem`).
  pinnedItems            PinnedItem[]
  /// Execuções de follow-up automático já rodadas ou rodando nesta conversa.
  followUpExecutions     FollowUpExecution[]
  /// Registros de idempotência de envios pela API de integração (ver
  /// `IntegrationMessageLog`). Referência frouxa: apagar a conversa não apaga
  /// o log, só zera o ponteiro.
  integrationMessageLogs IntegrationMessageLog[]
  /// Atendimentos por IA desta conversa (no máximo um ativo por vez —
  /// índice parcial na migration).
  aiSessions             AiSession[]
  aiUsageLogs            AiUsageLog[]

  @@unique([whatsappInstanceId, externalChatId])
  @@index([organizationId, status])
  @@index([organizationId, lastMessageAt])
  /// Dashboard: conversas com atividade no período agrupadas por status, e as
  /// candidatas a atraso (não resolvidas, paradas há mais que o limite).
  @@index([organizationId, status, lastMessageAt])
  /// Inbox: não arquivadas de um recorte ordenadas por última mensagem —
  /// o archivedAt vem antes para o filtro "IS NULL" usar o mesmo índice.
  @@index([organizationId, archivedAt, lastMessageAt])
  @@map("conversations")
}

/// Até onde CADA PESSOA leu uma conversa.
///
/// Guardamos a marca (o instante da última mensagem lida), e não um contador
/// por pessoa: contador exigiria escrever uma linha por usuário a cada
/// mensagem recebida — num grupo visível para dez atendentes, dez escritas
/// por mensagem. Com a marca, ler custa uma escrita só de quem leu, e o
/// número de não lidas é DERIVADO na consulta.
///
/// Linha ausente significa "nunca leu": nada é semeado, e conversa que
/// ninguém abriu aparece inteira como não lida — que é o estado seguro.
model ConversationRead {
  id                String   @id @default(uuid())
  organizationId    String
  conversationId    String
  userId            String
  /// Instante da última mensagem lida. Só avança sozinho — se a pessoa rolar
  /// para cima e reler mensagens antigas, a marca não recua e a conversa não
  /// volta a ter não lidas. Recuar é ação explícita ("marcar como não lida").
  lastReadAt        DateTime
  /// Onde a marca parou, para referência. Opcional de propósito: quem decide
  /// a contagem é o instante, e a mensagem pode ser apagada depois.
  lastReadMessageId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadMessage Message?     @relation(fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@unique([userId, conversationId])
  @@index([conversationId])
  @@map("conversation_reads")
}

// ============================================================
// Mensagens
// ============================================================

enum MessageDirection {
  inbound
  outbound
}

enum MessageType {
  text
  image
  audio
  video
  document
  sticker
  location
  contact
  poll
  call
  other
}

enum MessageStatus {
  pending
  sent
  delivered
  read
  failed
}

model Message {
  id                String           @id @default(uuid())
  organizationId    String
  conversationId    String
  externalMessageId String?
  senderExternalId  String?
  senderName        String?
  senderPhone       String?
  direction         MessageDirection
  type              MessageType
  content           String?
  mediaUrl          String?
  mimeType          String?
  filename          String?
  quotedMessageId   String?
  timestamp         DateTime
  status            MessageStatus    @default(pending)
  sentByUserId      String?
  /// Apagada para todos (mantemos a linha para histórico/auditoria)
  deletedAt         DateTime?
  deletedByUserId   String?
  /// Última edição do texto, quando houve
  editedAt          DateTime?
  /// Dados extras por tipo (ex.: opções da enquete)
  metadata          Json?
  createdAt         DateTime         @default(now())

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation           Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sentByUser             User?                   @relation(fields: [sentByUserId], references: [id], onDelete: SetNull)
  reactions              MessageReaction[]
  readMarks              ConversationRead[]
  pinnedItems            PinnedItem[]
  integrationMessageLogs IntegrationMessageLog[]

  @@unique([conversationId, externalMessageId])
  @@index([conversationId, timestamp])
  @@index([organizationId, timestamp])
  /// Contagem de não lidas por usuário: mensagens RECEBIDAS de uma conversa
  /// acima de um instante. Sem a direção na chave, a varredura teria de ler
  /// também tudo o que a equipe enviou.
  @@index([conversationId, direction, timestamp])
  @@map("messages")
}

// ============================================================
// Reações às mensagens (emoji)
// ============================================================

model MessageReaction {
  id               String   @id @default(uuid())
  messageId        String
  emoji            String
  /// JID de quem reagiu (ou o número conectado, quando fromMe)
  senderExternalId String
  senderName       String?
  fromMe           Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, senderExternalId])
  @@index([messageId])
  @@map("message_reactions")
}

// ============================================================
// Notas internas (não vão para o WhatsApp)
// ============================================================

model InternalNote {
  id             String   @id @default(uuid())
  organizationId String
  conversationId String
  userId         String?
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  pinnedItems  PinnedItem[]

  @@index([conversationId])
  @@map("internal_notes")
}

// ============================================================
// Mensagens fixadas ("pin")
// ============================================================

/// Fixação é INTERNA ao AZVCHAT: destaca uma mensagem (ou nota interna) no
/// topo da conversa, só para a equipe, e NUNCA é propagada ao WhatsApp — o
/// pin do próprio WhatsApp fixa para todos os participantes do grupo, e o
/// cliente veria o escritório fixando coisas no chat dele. Por isso não usa o
/// recurso de pin do Baileys e não chama o provider.
///
/// O alvo é polimórfico (`messageId` OU `noteId`, nunca os dois — garantido
/// pela constraint `pinned_items_one_target` na migration) porque nota
/// interna também pode ser fixada, e ela não é `Message`. Sem prazo de
/// validade de propósito: link de formulário e de pasta precisa continuar no
/// topo até alguém desafixar, diferente do WhatsApp.
model PinnedItem {
  id             String   @id @default(uuid())
  organizationId String
  conversationId String
  /// Nulo quando o alvo é uma nota interna.
  messageId      String?
  /// Nulo quando o alvo é uma mensagem.
  noteId         String?
  /// Quem fixou. Nulo segue o mesmo padrão de `archivedByUserId`/
  /// `deletedByUserId`: ação de alguém que pode não existir mais no cadastro.
  pinnedByUserId String?
  pinnedAt       DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  note         InternalNote? @relation(fields: [noteId], references: [id], onDelete: Cascade)
  pinnedBy     User?         @relation(fields: [pinnedByUserId], references: [id], onDelete: SetNull)

  // NULL não colide em índice único do Postgres, então várias fixações de
  // nota (messageId nulo) e várias de mensagem (noteId nulo) convivem — cada
  // unique só impede duplicar o MESMO alvo na mesma conversa.
  @@unique([conversationId, messageId])
  @@unique([conversationId, noteId])
  // Ordena a faixa ("1 de 3") e sustenta a contagem do limite de 3.
  @@index([conversationId, pinnedAt])
  @@map("pinned_items")
}

// ============================================================
// Etiquetas
// ============================================================

model Tag {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  color          String   @default("#6366f1")
  /// Vale para a organização inteira. Com ela ligada não existe vínculo em
  /// `departments`; desligada, a etiqueta precisa de pelo menos um.
  ///
  /// "Geral" é esta flag, e não a lista vazia: se lista vazia significasse
  /// geral, excluir um departamento tornaria uma etiqueta restrita visível
  /// para todo mundo sem ninguém perceber.
  isGeneral      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments           TagDepartment[]
  conversations         ConversationTag[]
  followUpSteps         FollowUpRuleStep[]
  followUpFinalizeRules FollowUpRule[]
  aiAutomations         AiAutomation[]

  // Nome único na organização inteira: a etiqueta aparece na conversa sem
  // dizer de qual departamento é, então dois "URGENTE" seriam indistinguíveis.
  @@unique([organizationId, name])
  @@index([isGeneral])
  @@map("tags")
}

/// Uma etiqueta serve a vários departamentos ao mesmo tempo: o mesmo
/// "Urgente" vale para Contábil, Fiscal e DP sem precisar de três cadastros.
model TagDepartment {
  tagId        String
  departmentId String

  tag        Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  // Cascade nas duas pontas. Excluir o departamento apaga só este vínculo —
  // a etiqueta continua existindo, some para quem não é admin e fica na tela
  // de gestão para o admin arrumar.
  @@id([tagId, departmentId])
  @@index([departmentId])
  @@map("tag_departments")
}

model ConversationTag {
  conversationId String
  tagId          String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@map("conversation_tags")
}

// ============================================================
// Histórico de atribuição de atendimento
// ============================================================

enum AssignmentAction {
  assigned
  transferred_user
  transferred_department
  unassigned
  /// Entrou no atendimento coletivo ("@todos"). Ação própria porque
  /// `assigned` significa pessoa: reaproveitá-la faria o histórico dizer
  /// "assumiu o atendimento" para uma marcação que não tem dono.
  assigned_to_all
  /// Saiu do coletivo — seja por ficar sem responsável, seja por alguém
  /// assumir (aí vem seguida de `assigned`).
  unassigned_from_all
  resolved
  reopened
}

model ConversationAssignmentHistory {
  id                String           @id @default(uuid())
  organizationId    String
  conversationId    String
  action            AssignmentAction
  fromUserId        String?
  toUserId          String?
  fromDepartmentId  String?
  toDepartmentId    String?
  performedByUserId String?
  note              String?
  createdAt         DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  performedBy  User?        @relation("PerformedAssignments", fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map("conversation_assignment_history")
}

// ============================================================
// Respostas rápidas (atalho com "/" no composer)
// ============================================================

model QuickReply {
  id             String    @id @default(uuid())
  organizationId String
  /// Atalho digitado após a barra, ex.: "bomdia" -> /bomdia
  shortcut       String
  title          String?
  content        String
  /// Vale para a organização inteira. Mesma regra da etiqueta: com ela
  /// ligada não existe vínculo em `departments`; desligada, precisa de pelo
  /// menos um.
  isGeneral      Boolean   @default(false)
  /// Mídia opcional (imagem, áudio ou vídeo) que sai junto com o texto.
  /// `mediaUrl` é a chave no MediaStorage — mesmo esquema da Message; a
  /// imagem nunca sai por URL pública, só por rota autenticada.
  mediaUrl       String?
  mediaMimeType  String?
  mediaFilename  String?
  /// Última vez que o atalho foi de fato ENVIADO pelo composer (não a
  /// edição do cadastro). É como a equipe descobre resposta parada que
  /// ninguém usa mais. Null = nunca usada desde que a coluna existe.
  lastUsedAt     DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments  QuickReplyDepartment[]
  createdBy    User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  // Atalho único na organização: "/bomdia" não pode significar duas coisas
  // diferentes dependendo de quem digita.
  @@unique([organizationId, shortcut])
  @@index([isGeneral])
  @@map("quick_replies")
}

/// O mesmo texto padrão serve a vários departamentos — ver TagDepartment.
model QuickReplyDepartment {
  quickReplyId String
  departmentId String

  quickReply QuickReply @relation(fields: [quickReplyId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([quickReplyId, departmentId])
  @@index([departmentId])
  @@map("quick_reply_departments")
}

// ============================================================
// Mensagens agendadas
// ============================================================

enum ScheduledMessageStatus {
  pending
  sent
  failed
  canceled
}

model ScheduledMessage {
  id             String                 @id @default(uuid())
  organizationId String
  conversationId String
  content        String
  scheduledFor   DateTime
  status         ScheduledMessageStatus @default(pending)
  createdById    String?
  sentMessageId  String?
  error          String?
  /// Tentativas de envio já realizadas (falhas temporárias são retentadas)
  attempts       Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@index([conversationId])
  @@map("scheduled_messages")
}

// ============================================================
// Follow-up automático
// ============================================================

/// Regra ativa dispara; inativa fica no cadastro sem gerar execução nova
/// (a execução já em andamento é cancelada — regra desligada não deixa
/// timer solto rodando por trás).
enum FollowUpRuleStatus {
  active
  inactive
}

enum FollowUpTimeUnit {
  minutes
  hours
  days
}

/// O que uma etapa faz quando o prazo dela vence. "Encaminhar" e
/// "webhook/API" (citados no pedido original) ficaram de fora desta
/// entrega — abrir uma automação a HTTP arbitrário é superfície de ataque
/// que merece desenho próprio, e "encaminhar" precisaria da mesma régua de
/// `conversationAssigneeWhere` que a transferência manual já usa.
enum FollowUpStepAction {
  send_message
  add_tag
  remove_tag
  change_status
}

/// Gatilho que inicia a régua. Só existe UM hoje — status = aguardando
/// cliente, o pedido explicitamente como prioridade —, mas o campo já vem
/// como enum (e não como boolean fixo) para os gatilhos "citados se
/// compatíveis" (tag, departamento, fila) entrarem sem migration de novo.
enum FollowUpTrigger {
  waiting_client
}

enum FollowUpExecutionStatus {
  active
  paused
  canceled
  completed
  /// Etapa não pôde ser aplicada (número desconectado, etc.) e a régua
  /// desistiu — nunca reprocessa sozinha; o histórico mostra o erro.
  failed
}

/// Todo evento relevante da execução, para o Histórico (seção 33 do
/// pedido) — contato, etapa, horário previsto x executado, cancelamento,
/// adiamento, pausa, erro, tudo em UMA tabela, na mesma ideia do AuditLog.
enum FollowUpLogEventType {
  started
  step_executed
  step_failed
  restarted
  canceled
  paused
  resumed
  postponed
  completed
}

/// Regra de follow-up automático — dispara mensagens (e outras ações) por
/// tempo sem resposta do cliente. Departamento é N:N, EXATAMENTE como em
/// `QuickReply`/`Tag`: `isGeneral` vale para a organização inteira, ou a
/// regra tem uma ou mais linhas em `FollowUpRuleDepartment` — nunca as duas
/// coisas, mesma validação de `lib/department-resource.ts`. Isso é o que
/// permite UMA regra ser usada por vários departamentos sem duplicar linha
/// nenhuma: `Comercial + Financeiro` é a mesma `FollowUpRule`, com dois
/// vínculos.
model FollowUpRule {
  id                   String             @id @default(uuid())
  organizationId       String
  name                 String
  description          String?
  status               FollowUpRuleStatus @default(active)
  /// Vale para todos os departamentos. Espelha `Tag.isGeneral`.
  isGeneral            Boolean            @default(false)
  trigger              FollowUpTrigger    @default(waiting_client)
  /// Fora do expediente configurado (`AttendanceSettings`), a etapa vencida
  /// não sai: `lib/business-schedule.ts` empurra `nextRunAt` para a abertura
  /// do próximo dia útil. Desligado, a régua roda a qualquer hora.
  respectBusinessHours Boolean            @default(true)
  /// Filtro opcional por número — a maioria das regras vale para qualquer
  /// número do departamento; quando marcado, só dispara em conversas deste.
  whatsappInstanceId   String?
  /// Depois da última etapa, encerra o atendimento sozinho (seção 13/31 do
  /// pedido). Desligado, a régua só envia mensagens e para na última etapa.
  finalizeOnComplete   Boolean            @default(true)
  finalizeReason       String             @default("Sem retorno do cliente")
  /// Etiqueta opcional aplicada junto do encerramento automático.
  finalizeTagId        String?
  createdById          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?                    @relation("FollowUpRuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  instance     WhatsAppInstance?        @relation(fields: [whatsappInstanceId], references: [id], onDelete: SetNull)
  finalizeTag  Tag?                     @relation(fields: [finalizeTagId], references: [id], onDelete: SetNull)
  departments  FollowUpRuleDepartment[]
  steps        FollowUpRuleStep[]
  executions   FollowUpExecution[]

  // Nome único na organização, como o atalho da resposta rápida — a tela
  // principal lista por nome e duplicidade confundiria qual regra é qual.
  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("follow_up_rules")
}

model FollowUpRuleDepartment {
  ruleId       String
  departmentId String

  rule       FollowUpRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  department Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([ruleId, departmentId])
  @@index([departmentId])
  @@map("follow_up_rule_departments")
}

/// Uma etapa da régua ("aguardar N, depois fazer X"), em ordem. `order`
/// começa em 1 — é também o "etapa 1 de 3" mostrado na conversa.
model FollowUpRuleStep {
  id             String              @id @default(uuid())
  ruleId         String
  order          Int
  waitAmount     Int
  waitUnit       FollowUpTimeUnit
  action         FollowUpStepAction
  /// Texto da mensagem — aceita o MESMO catálogo de variáveis da resposta
  /// rápida (`{{primeiro_nome}}` etc.), resolvido na hora do disparo.
  messageContent String?
  /// Etiqueta alvo de add_tag/remove_tag.
  tagId          String?
  /// Status alvo de change_status.
  newStatus      ConversationStatus?

  rule FollowUpRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  tag  Tag?         @relation(fields: [tagId], references: [id], onDelete: SetNull)

  @@unique([ruleId, order])
  @@map("follow_up_rule_steps")
}

/// Uma régua RODANDO sobre uma conversa específica — o "timer" do pedido.
/// Só uma ATIVA ou PAUSADA por conversa ao mesmo tempo (índice parcial na
/// migration, `follow_up_executions_one_active_per_conversation`): é o que
/// impede dois timers correndo em paralelo sobre o mesmo atendimento.
model FollowUpExecution {
  id                String                  @id @default(uuid())
  organizationId    String
  ruleId            String
  conversationId    String
  status            FollowUpExecutionStatus @default(active)
  /// Etapa que está para rodar (1-based, casa com `FollowUpRuleStep.order`).
  currentStepOrder  Int                     @default(1)
  /// Hora da próxima ação. Nulo quando pausada sem prazo, cancelada,
  /// concluída ou com falha — a varredura do worker só olha `active`.
  nextRunAt         DateTime?
  /// Pausa COM prazo (seção 29): reativa sozinha ao chegar aqui. Nulo com
  /// `status = paused` é pausa SEM prazo — só o atendente destrava.
  pauseUntil        DateTime?
  startedAt         DateTime                @default(now())
  finishedAt        DateTime?
  /// "client_replied" | "completed_no_reply" | "canceled_manual" |
  /// "canceled_status_change" | "canceled_department_change" |
  /// "rule_deactivated" | "conversation_archived" | "send_failed".
  finishReason      String?
  messagesSentCount Int                     @default(0)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule         FollowUpRule           @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  conversation Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  logs         FollowUpExecutionLog[]

  @@index([conversationId])
  @@index([status, nextRunAt])
  @@index([organizationId, ruleId])
  @@map("follow_up_executions")
}

/// Histórico completo (seção 33/34 do pedido): uma linha por evento da
/// execução. `actorUserId` presente = ação manual do atendente (cancelar,
/// adiar, pausar, retomar); nulo = o worker agiu sozinho.
model FollowUpExecutionLog {
  id          String               @id @default(uuid())
  executionId String
  eventType   FollowUpLogEventType
  stepOrder   Int?
  actorUserId String?
  messageId   String?
  detail      String?
  createdAt   DateTime             @default(now())

  execution FollowUpExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  actor     User?             @relation("FollowUpExecutionLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([executionId, createdAt])
  @@map("follow_up_execution_logs")
}

// ============================================================
// Auditoria
// ============================================================

/// O que cada perfil PODE FAZER nesta organização, por par (papel, ação).
///
/// Só grava o que difere do catálogo: AUSÊNCIA DE LINHA significa o padrão
/// de `PERMISSION_ACTIONS` (@azvchat/shared). Gravar as ~25 linhas por papel
/// de saída congelaria os padrões no banco — mudar um padrão no código
/// deixaria de valer para quem já existe, e o catálogo perderia o sentido.
///
/// `admin` nunca tem linha aqui (constraint no banco): administrador passa
/// por cima de tudo, senão a organização conseguiria se trancar do lado de
/// fora sem ninguém para religar.
///
/// PERMISSÃO É AÇÃO, NUNCA ALCANCE: nada nesta tabela decide quais conversas
/// alguém enxerga — isso continua saindo de lib/access.ts, pelos vínculos de
/// número e departamento.
model RolePermission {
  id             String   @id @default(uuid())
  organizationId String
  role           UserRole
  /// Nome técnico da ação no catálogo. Texto, e não enum: ação some do
  /// código sem exigir migration, e a linha órfã é ignorada em silêncio.
  action         String
  allowed        Boolean
  /// Quem mudou por último — a tela mostra ao lado da chave alterada.
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy    User?        @relation("RolePermissionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, role, action])
  @@index([organizationId])
  @@map("role_permissions")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ============================================================
// Parâmetros de atendimento (SLA e expediente)
// ============================================================

/// Política de atendimento do escritório: em quanto tempo o cliente precisa
/// ser respondido e em que horários esse tempo corre. Fica no banco, e não
/// no código, porque muda sem deploy — e o dashboard lê a cada requisição.
///
/// Uma linha por organização hoje. A tabela filha aponta para esta, e não
/// para a organização: no dia em que existir parâmetro por departamento,
/// basta uma nova linha aqui. Nenhuma coluna de departamento agora.
model AttendanceSettings {
  id                      String   @id @default(uuid())
  organizationId          String   @unique
  /// Minutos sem resposta, contados só dentro do expediente, para o
  /// atendimento entrar como atrasado.
  responseLimitMinutes    Int      @default(30)
  /// Fuso do escritório. Todo corte de data do dashboard usa este fuso,
  /// nunca o UTC do servidor.
  timezone                String   @default("America/Sao_Paulo")
  /// Liga a restrição de horário de login. Desligada por padrão: ligada de
  /// saída, um deploy trancaria do lado de fora quem já estava trabalhando.
  loginRestrictionEnabled Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessHours AttendanceBusinessHours[]
  loginHours    AttendanceLoginHours[]

  @@map("attendance_settings")
}

/// Expediente de um dia da semana. Sete linhas por configuração — cada dia
/// se liga e desliga sozinho, porque o escritório pode passar a atender
/// sábado de manhã sem mexer nos outros dias.
model AttendanceBusinessHours {
  id         String  @id @default(uuid())
  settingsId String
  /// 0 = domingo ... 6 = sábado, igual a `Date#getDay()` e a `EXTRACT(DOW)`.
  weekday    Int
  active     Boolean @default(true)
  /// "HH:MM" no fuso da configuração. Texto, e não `time`, porque é
  /// exatamente o formato que a tela envia e que o cálculo consome.
  startTime  String  @default("08:00")
  endTime    String  @default("18:00")

  settings AttendanceSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, weekday])
  @@map("attendance_business_hours")
}

/// Janela de login de um dia da semana, aplicada só a quem não é supervisor.
/// Tabela separada do expediente porque as duas faixas não são a mesma coisa:
/// o expediente mede o atraso do dashboard, esta aqui diz quem consegue
/// entrar. Sete linhas por configuração, cada dia ligando sozinho.
model AttendanceLoginHours {
  id         String  @id @default(uuid())
  settingsId String
  /// 0 = domingo ... 6 = sábado, igual a `Date#getDay()` e a `EXTRACT(DOW)`.
  weekday    Int
  /// Dia desligado é dia sem login nenhum para quem não é supervisor.
  active     Boolean @default(true)
  /// "HH:MM" no fuso da configuração, mesmo formato do expediente.
  startTime  String  @default("07:00")
  endTime    String  @default("19:00")

  settings AttendanceSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, weekday])
  @@map("attendance_login_hours")
}

// ============================================================
// Integração de envio para sistemas externos (token de máquina)
// ============================================================

/// Token de integração: credencial de MÁQUINA para outro sistema do escritório
/// disparar UMA mensagem de WhatsApp (ex.: confirmação de agendamento). Não é
/// sessão de usuário — a rota de envio tem guard próprio, fora de `auth.ts`,
/// e não passa por `requireRole`.
///
/// Guardamos só o HASH do token (`tokenHash`, sha256): o valor em claro é
/// mostrado uma única vez, na criação, e nunca mais. Cada token é amarrado a
/// EXATAMENTE uma instância (`whatsappInstanceId`): um token vazado manda
/// mensagem só por aquele número. Revogar é `active = false`, nunca apagar —
/// o histórico de uso continua de pé.
model IntegrationToken {
  id                 String    @id @default(uuid())
  organizationId     String
  name               String
  /// Prefixo visível ("azv_a1b2c3d4"), para a tela identificar o token sem
  /// nunca guardar o segredo.
  tokenPrefix        String
  /// sha256 do token inteiro — a autenticação é igualdade por este índice.
  tokenHash          String    @unique
  whatsappInstanceId String
  active             Boolean   @default(true)
  /// Quem criou. Nulo = o criador não existe mais no cadastro; o token
  /// continua válido, porque pertence à integração, não à pessoa.
  createdById        String?
  lastUsedAt         DateTime?
  usageCount         Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instance     WhatsAppInstance        @relation(fields: [whatsappInstanceId], references: [id], onDelete: Cascade)
  createdBy    User?                   @relation("IntegrationTokenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  messageLogs  IntegrationMessageLog[]

  @@index([organizationId])
  @@index([whatsappInstanceId])
  @@map("integration_tokens")
}

/// Registro de envio por chave de idempotência. Quando o sistema externo tenta
/// de novo por timeout, a MESMA chave dentro de 24h não reenvia — devolve o
/// resultado do envio original (conversa, mensagem, telefone normalizado).
/// Uma linha por (token, chave); reuso após 24h sobrescreve a linha e a janela
/// anda junto. Conversa/mensagem são referência frouxa (SET NULL): podem ser
/// apagadas sem apagar o registro.
model IntegrationMessageLog {
  id                 String   @id @default(uuid())
  integrationTokenId String
  idempotencyKey     String
  conversationId     String?
  messageId          String?
  normalizedPhone    String
  status             String
  createdAt          DateTime @default(now())

  token        IntegrationToken @relation(fields: [integrationTokenId], references: [id], onDelete: Cascade)
  conversation Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message      Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([integrationTokenId, idempotencyKey])
  @@index([integrationTokenId, createdAt])
  @@map("integration_message_logs")
}

// ============================================================
// Inteligência artificial
// ============================================================
//
// A separação central: o AGENTE é a configuração reutilizável (objetivo,
// limites, conhecimento, permissões), a AUTOMAÇÃO é o gatilho que o põe para
// atender numa conversa, e a SESSÃO é um atendimento concreto. Configura-se a
// "IA Comercial" uma vez e ela serve a quantas automações forem precisas.
// Ver CLAUDE.md §20.

enum AiProviderStatus {
  not_connected
  connected
  error
}

enum AiAgentStatus {
  draft
  active
  inactive
}

enum AiSessionStatus {
  active
  resolved
  transferred
  stopped
  limit_reached
  error
  expired
}

enum AiKnowledgeKind {
  text
  faq
}

enum AiBudgetPolicy {
  alert_only
  block_new
  transfer_human
}

enum AiUsageKind {
  chat
  test
  connection_test
  models
}

enum AiUsageOutcome {
  ok
  error
  timeout
  blocked
}

/// Credencial de um provedor de IA, por organização. A chave é gravada
/// CIFRADA (AES-256-GCM, chave em `AI_SECRETS_KEY` no processo da API — ver
/// `lib/ai-secrets.ts`) e nunca sai da API: para a tela vai só `apiKeyHint`
/// ("sk-••••8F2A"). Não há `NEXT_PUBLIC_` equivalente e nunca haverá.
model AiProviderConfig {
  id              String           @id @default(uuid())
  organizationId  String
  /// "openai" hoje; texto (e não enum) para provedor novo não exigir migration.
  provider        String
  apiKeyEncrypted String?
  apiKeyHint      String?
  defaultModel    String?
  status          AiProviderStatus @default(not_connected)
  lastTestedAt    DateTime?
  /// Última falha do teste de conexão, em português e sem detalhe sensível.
  lastTestError   String?
  /// Lista de modelos devolvida pelo provedor, para a tela não bater nele a
  /// cada abertura. Só ids e rótulos — nada de segredo.
  modelsCache     Json?
  modelsFetchedAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@map("ai_provider_configs")
}

/// Configurações gerais de IA da organização: orçamento, política ao
/// estourar, timeout do provedor. Uma linha por organização; ausente = os
/// padrões de `@azvchat/shared`.
model AiSettings {
  id                  String         @id @default(uuid())
  organizationId      String         @unique
  /// Orçamento mensal em CENTAVOS de dólar (a moeda do provedor). Nulo = sem teto.
  monthlyBudgetCents  Int?
  /// Percentuais que disparam alerta (50, 80, 90, 100).
  alertThresholds     Int[]          @default([50, 80, 90, 100])
  budgetPolicy        AiBudgetPolicy @default(alert_only)
  /// Timeout de cada chamada ao provedor, em ms.
  timeoutMs           Int            @default(30000)
  /// Quantas mensagens recentes vão ao modelo quando o agente não define.
  contextMessageLimit Int            @default(20)
  /// Preço por modelo sobreposto pelo escritório (USD por 1M tokens).
  pricingOverrides    Json?
  /// Mês (AAAA-MM) e degraus já avisados nele — para o alerta de 80% não
  /// repetir a cada chamada.
  alertedMonth        String?
  alertedThresholds   Int[]          @default([])
  updatedById         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy    User?        @relation("AiSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("ai_settings")
}

/// Agente de IA: a configuração reutilizável. `config` é o JSON estruturado
/// validado pelo Zod da rota (`AiAgentConfig`, em `@azvchat/shared`) — são
/// dezenas de campos que só a IA lê, e uma coluna por campo obrigaria uma
/// migration a cada ajuste de prompt. O que é consultado por SQL (status,
/// modelo, departamentos) tem coluna própria.
model AiAgent {
  id                  String        @id @default(uuid())
  organizationId      String
  name                String
  description         String        @default("")
  status              AiAgentStatus @default(draft)
  /// Vale para todos os departamentos (mesma regra de etiqueta/resposta rápida).
  isGeneral           Boolean       @default(false)
  /// Modelo do agente; nulo = padrão do sistema.
  model               String?
  /// Configuração ATUAL (a última salva). Cada gravação que muda algo também
  /// grava uma `AiAgentVersion`, e é a versão que a sessão referencia.
  config              Json
  currentVersion      Int           @default(1)
  /// Departamento e responsável de transferência — colunas (e não só JSON)
  /// para o banco apagar a referência quando o alvo some.
  handoffDepartmentId String?
  handoffAssigneeId   String?
  createdById         String?
  updatedById         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy         User?                    @relation("AiAgentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy         User?                    @relation("AiAgentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  handoffDepartment Department?              @relation("AiAgentHandoffDepartment", fields: [handoffDepartmentId], references: [id], onDelete: SetNull)
  handoffAssignee   User?                    @relation("AiAgentHandoffAssignee", fields: [handoffAssigneeId], references: [id], onDelete: SetNull)
  departments       AiAgentDepartment[]
  versions          AiAgentVersion[]
  knowledgeSources  AiAgentKnowledgeSource[]
  automations       AiAutomation[]
  sessions          AiSession[]
  usageLogs         AiUsageLog[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("ai_agents")
}

model AiAgentDepartment {
  agentId      String
  departmentId String

  agent      AiAgent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([agentId, departmentId])
  @@index([departmentId])
  @@map("ai_agent_departments")
}

/// Foto da configuração no momento de cada gravação. A sessão aponta para a
/// versão com que começou: mudar a IA Comercial enquanto há atendimentos em
/// andamento não troca as regras no meio da conversa.
model AiAgentVersion {
  id          String   @id @default(uuid())
  agentId     String
  version     Int
  model       String?
  config      Json
  createdById String?
  createdAt   DateTime @default(now())

  agent     AiAgent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdBy User?       @relation("AiAgentVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sessions  AiSession[]

  @@unique([agentId, version])
  @@map("ai_agent_versions")
}

/// Fonte da base de conhecimento: texto livre ou perguntas e respostas. A
/// busca é lexical, por trechos (`services/ai/knowledge.ts`) — só os trechos
/// relevantes vão ao modelo, nunca a base inteira.
model AiKnowledgeSource {
  id             String          @id @default(uuid())
  organizationId String
  title          String
  kind           AiKnowledgeKind @default(text)
  content        String
  active         Boolean         @default(true)
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?                    @relation("AiKnowledgeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  agents       AiAgentKnowledgeSource[]

  @@index([organizationId, active])
  @@map("ai_knowledge_sources")
}

model AiAgentKnowledgeSource {
  agentId  String
  sourceId String

  agent  AiAgent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  source AiKnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([agentId, sourceId])
  @@index([sourceId])
  @@map("ai_agent_knowledge_sources")
}

/// Automação: o gatilho que põe um agente para atender — o "bloco de IA".
/// Casa a mensagem que chega por número, departamento e tipo de conversa;
/// nulo = qualquer. `onlyWithoutDepartment` é o caso "só conversa que o
/// número não classificou" (departamento nulo não é "qualquer" nem um id).
model AiAutomation {
  id                    String   @id @default(uuid())
  organizationId        String
  name                  String
  active                Boolean  @default(true)
  agentId               String
  whatsappInstanceId    String?
  departmentId          String?
  onlyWithoutDepartment Boolean  @default(false)
  conversationType      String   @default("any")
  /// Só entra em conversa sem responsável (o normal: a IA não toma conversa de gente).
  onlyUnassigned        Boolean  @default(true)
  /// Só na PRIMEIRA mensagem de uma conversa nova.
  onlyNewConversations  Boolean  @default(false)
  /// Etiqueta aplicada quando a IA resolve sozinha.
  resolvedTagId         String?
  /// Menor vence quando mais de uma casa.
  priority              Int      @default(100)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        AiAgent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  instance     WhatsAppInstance? @relation(fields: [whatsappInstanceId], references: [id], onDelete: Cascade)
  department   Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  resolvedTag  Tag?              @relation(fields: [resolvedTagId], references: [id], onDelete: SetNull)
  sessions     AiSession[]

  @@index([organizationId, active, priority])
  @@map("ai_automations")
}

/// Um atendimento por IA: uma conversa, um agente (numa versão), do começo ao
/// fim. `state` é a memória do atendimento (dados coletados, assunto,
/// resumo). Índice parcial garante NO MÁXIMO UMA ativa por conversa.
model AiSession {
  id                     String          @id @default(uuid())
  organizationId         String
  conversationId         String
  agentId                String
  agentVersionId         String?
  automationId           String?
  status                 AiSessionStatus @default(active)
  state                  Json?
  aiMessageCount         Int             @default(0)
  customerMessageCount   Int             @default(0)
  failedAttempts         Int             @default(0)
  inputTokens            Int             @default(0)
  outputTokens           Int             @default(0)
  /// Custo estimado em micro-dólares (1 USD = 1.000.000).
  costMicros             Int             @default(0)
  /// Última mensagem recebida já processada — idempotência entre turnos e
  /// após reinício.
  lastProcessedMessageId String?
  summary                String?
  endReason              String?
  endedByUserId          String?
  startedAt              DateTime        @default(now())
  lastActivityAt         DateTime        @default(now())
  endedAt                DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent        AiAgent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentVersion AiAgentVersion? @relation(fields: [agentVersionId], references: [id], onDelete: SetNull)
  automation   AiAutomation?   @relation(fields: [automationId], references: [id], onDelete: SetNull)
  endedBy      User?           @relation("AiSessionEndedBy", fields: [endedByUserId], references: [id], onDelete: SetNull)
  usageLogs    AiUsageLog[]

  @@index([conversationId, status])
  @@index([organizationId, status, startedAt])
  @@index([agentId, startedAt])
  @@map("ai_sessions")
}

/// Uma chamada ao provedor: tokens, custo estimado, duração, ferramentas
/// pedidas/executadas/bloqueadas. NUNCA o conteúdo da conversa nem a chave.
model AiUsageLog {
  id             String         @id @default(uuid())
  organizationId String
  sessionId      String?
  agentId        String?
  /// Nome na hora da chamada — sobrevive à exclusão do agente.
  agentName      String?
  conversationId String?
  departmentId   String?
  provider       String
  model          String
  kind           AiUsageKind    @default(chat)
  outcome        AiUsageOutcome @default(ok)
  inputTokens    Int            @default(0)
  outputTokens   Int            @default(0)
  /// Nulo = modelo sem tabela de preço; a chamada fica fora do custo total.
  costMicros     Int?
  durationMs     Int            @default(0)
  errorCode      String?
  toolsRequested Json?
  toolsExecuted  Json?
  toolsBlocked   Json?
  handoffReason  String?
  createdAt      DateTime       @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      AiSession?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  agent        AiAgent?      @relation(fields: [agentId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([agentId, createdAt])
  @@map("ai_usage_logs")
}
