# ======================================
# ZapDesk - Variáveis de ambiente
# Copie para .env e ajuste os valores.
# ======================================

# --- Banco de dados (PostgreSQL) ---
DATABASE_URL="postgresql://azvchat:azvchat@localhost:5432/azvchat?schema=public"

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
# Origem permitida para CORS (URL do frontend)
WEB_ORIGIN=http://localhost:3000
# Segredo do JWT — gere um valor forte: openssl rand -hex 32
JWT_SECRET=change-me-please-use-openssl-rand-hex-32
# Validade do token de acesso
JWT_EXPIRES_IN=12h

# --- Sessões do WhatsApp ---
# Diretório onde as credenciais de sessão (Baileys) são persistidas.
# Em produção deve ser um volume persistente. NUNCA commitar esse diretório.
WHATSAPP_SESSION_DIR=./data/sessions
# Proxy HTTPS opcional para o WebSocket do WhatsApp (só necessário em redes restritas)
# WHATSAPP_PROXY_URL=http://proxy.interno:3128

# --- Mídia ---
# Diretório onde arquivos recebidos/enviados são armazenados (driver local).
MEDIA_DIR=./data/media
# Tamanho máximo de upload em bytes (padrão 25MB)
MEDIA_MAX_SIZE=26214400

# --- Integração com o Azevedo-OS (opcional) ---
# O Azevedo-OS é a fonte da verdade do cadastro empresarial; o AZVCHAT só
# guarda o ponteiro para a empresa e consulta na hora de exibir o card.
# Faltando a URL ou o token, a integração fica desligada e o card avisa —
# nada mais no sistema é afetado.
#
# URL BASE da API de integração do Azevedo-OS (a que expõe /companies).
AZEVEDO_OS_API_URL=
# Token do servidor. NUNCA usar NEXT_PUBLIC_ aqui: ele vive só no processo
# da API, não vai para o banco, para log nem para o navegador.
AZEVEDO_OS_API_TOKEN=
# Endereço da empresa na web do Azevedo-OS, com {id} onde entra o
# identificador (ex.: https://gestao.seudominio.com.br/empresas/{id}).
# Sem esta variável o botão "Abrir no Azevedo-OS" simplesmente não aparece.
AZEVEDO_OS_WEB_URL=
# Timeout da chamada, em milissegundos (padrão 5000). Curto de propósito:
# a Inbox não pode ficar pendurada esperando um sistema externo.
AZEVEDO_OS_TIMEOUT_MS=5000

# --- Lembrete de cobrança do Financeiro (opcional, sentido inverso) ---
# Aqui é o Azevedo-OS chamando PARA o AZVCHAT, para mandar lembrete de
# cobrança por WhatsApp. Escopo fixo de propósito: um único número
# pré-cadastrado, nunca escolhido pela chamada. Faltando token OU instance,
# a rota responde 503 — nunca fica aberta por omissão.
#
# Token de serviço que o Azevedo-OS apresenta em Authorization: Bearer <token>.
# Gere um valor forte: openssl rand -hex 32
FINANCEIRO_LEMBRETE_TOKEN=
# Id (uuid) do WhatsAppInstance que envia os lembretes do Financeiro.
FINANCEIRO_WHATSAPP_INSTANCE_ID=

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Logs ---
LOG_LEVEL=info
